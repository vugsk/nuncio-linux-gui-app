// Главное окно вертикали (В4): список диалогов и чат в две колонки
// (Дизайн - Каркас и навигация, раздел 2; Дизайн - Список диалогов; Дизайн - Чат).
// Упрощённо по плану В4: пузыри без вложений и форматирования, обычный
// TextInput, стандартная прокрутка. Узкое окно (меньше 780 px, Дз-6′) — одна колонка.
import { Settings, SettingsWindow } from "settings.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button, Link, Modal, Confirm, Field, CheckBox } from "widgets.slint";

export struct DialogItem {
    id: string,        // помеченный id собеседника (i64 строкой)
    name: string,
    initials: string,
    color: color,
    avatar: image,
    has-avatar: bool,
    prefix: string,    // «Вы:» перед превью
    preview: string,
    preview-accent: bool, // служебное или вложение — другим цветом
    time: string,
    unread: int,
    pinned: bool,
    selected: bool,
    out-state: int,    // своё последнее: 0 нет, 1 отправлено, 2 прочитано
    // Меню диалога (Сп-4) и значки.
    muted: bool,
    archived: bool,
    kind: int,         // 0 личный, 1 группа, 2 канал
    is-self: bool,
    unread-mark: bool,
    folder-mask: int,  // в каких папках (бит i — i-я папка после «Все чаты»)
}

// Пункт фильтра списка: 0 «Все чаты», 1 архив, 2 папка (id).
export struct FolderItem {
    kind: int,
    id: int,
    title: string,
    unread: int,
    selected: bool,
}

// Строка результатов поиска: заголовок раздела или чат, или сообщение.
export struct SearchRow {
    header: bool,
    peer: string,
    msg: string,
    title: string,
    text: string,
    time: string,
    initials: string,
    color: color,
    avatar: image,
    has-avatar: bool,
}

// Общие медиа в «Сведениях» (Св-1): ячейка сетки и строка списка.
export struct SharedCell {
    id: int,
    img: image,
    has-img: bool,
    play: bool,
    dur: string,
}

export struct SharedRow {
    id: int,
    title: string,
    subtitle: string,
    // 0 файл, 1 ссылка, 2 голосовое или аудио.
    icon: int,
    // 0 не скачан, 1 скачивается, 2 скачан.
    state: int,
    progress: float,
    url: string,
}

export struct MemberItem {
    id: string,
    name: string,
    initials: string,
    color: color,
    avatar: image,
    has-avatar: bool,
    role: string,
}

// Текст с эмодзи-картинками (О-14): строки из сегментов, разложенные в Rust.
export struct RichSeg {
    text: string,
    image: image,
    emoji: bool,
    // Форматирование (Дз-15): начертание, линии, моноширинный, ссылка.
    bold: bool,
    italic: bool,
    underline: bool,
    strike: bool,
    mono: bool,
    link: string,
}

export struct RichLine {
    segs: [RichSeg],
}

// Живой кадр GIF или кружка, играющего в ленте (В8): поверх превью.
export struct LiveFrame {
    mid: string,
    img: image,
}

// Файл в панели подготовки вложений (Св-4).
export struct PrepItem {
    name: string,
    info: string,   // размер
    img: image,
    has-img: bool,
}

// Вариант ответа опроса (Чт-13).
export struct PollRow {
    text: string,
    rich: bool,          // с эмодзи — строками с картинками
    lines: [RichLine],
    share: float,  // доля голосов 0…1 (видна после голосования)
    percent: string,
    chosen: bool,
    correct: bool,
}

// Ячейка альбома (Чт-11).
export struct AlbumCell {
    id: string,
    img: image,
    has-img: bool,
    play: bool,
    x: length,
    y: length,
    w: length,
    h: length,
}

export struct MessageItem {
    date-label: string, // непусто — перед сообщением разделитель даты
    text: string,
    time: string,
    out: bool,
    service: bool,
    sender: string,     // имя над первым в серии (группы)
    sender-color: color,
    media: string,      // «Фото», «Файл» и т. п. (вложения — В7)
    edited: bool,
    read: bool,         // своё прочитано собеседником
    first-in-series: bool,
    // Очередь отправки (Чт-6): 0 отправлено, 1 в очереди, 2 отправляется, 3 не отправлено.
    send-state: int,
    local-id: string,
    send-error: string, // причина «не отправлено» (уже на языке интерфейса)
    last-read: bool,    // последнее своё и прочитано — «прочитано» видно всегда (Чт-6)
    id: string,
    reply-author: string, // цитата ответа (Чт-3): непусто — показать
    reply-text: string,
    reply-color: color,
    fwd-name: string,     // «Переслано от …»
    can-edit: bool,
    can-delete: bool,
    pinned: bool,
    has-link: bool,
    key: int,             // id сообщения или −local_id (очередь): порядок и высоты строк
    sponsored: bool,      // строка рекламы в конце ленты (условия API; данные — в Chat.sp-*)
    unread-divider: bool, // линия «Новые сообщения» перед сообщением (Чт-10)
    reply-id: string,     // клик по цитате — переход к исходному
    rich: bool,           // текст с эмодзи: рисовать `lines`, а не `text`
    lines: [RichLine],
    big-emoji: [image],   // 1–3 эмодзи без текста — крупно без пузыря (Чт-12)
    // Вложение (В7, Чт-11…Чт-13): 0 нет (или подпись `media`), 1 картинка (фото,
    // видео, GIF), 2 файл, голосовое или аудио, 3 превью ссылки, 4 опрос, 5 альбом.
    mkind: int,
    mid: string,          // id для нажатия на вложение (у очереди — отрицательный)
    mimg: image,
    mhas-img: bool,
    mw: length,
    mh: length,
    mplay: bool,          // видео: кнопка «играть»
    mround: bool,         // кружок (видеосообщение): круг без пузыря
    mgif: bool,           // GIF: плашка, играет в ленте сам
    mpath: string,        // скачанный файл GIF или кружка — для игры в ленте
    mdur: string,         // длительность видео
    file-name: string,
    file-info: string,    // размер или «1,2 из 5,0 МБ»
    file-state: int,      // 0 скачать, 1 скачивается, 2 скачано, 3 играет, 4 пауза (голосовые, В8)
    file-progress: float,
    file-voice: bool,
    wp-site: string,
    wp-title: string,
    wp-desc: string,
    poll-question: string,
    poll-qrich: bool,
    poll-qlines: [RichLine],
    poll-info: string,
    poll-voted: bool,
    poll-options: [PollRow],
    album: [AlbumCell],
}


export struct PickerItem {
    id: string,
    name: string,
    initials: string,
    color: color,
    subtitle: string,
    selected: bool,
}

export struct SelRect {
    x: length,
    y: length,
    w: length,
    h: length,
}

// Поле ввода — гибрид (Дз-17, composer.rs): невидимый TextInput — движок,
// текст, каретку и выделение рисует наша раскладка.
export global Composer {
    in-out property <string> text;
    in property <[RichLine]> lines;
    in property <[SelRect]> selection;
    in property <length> caret-x;
    in property <length> caret-y;
    in property <length> content-height: 20px;
    in property <length> scroll-y;
    // Rust просит TextInput выделить: применяется при смене номера.
    in property <int> sel-seq;
    in property <int> sel-anchor;
    in property <int> sel-cursor;
    // Стили на выделении — подсветка кнопок панели (Дз-15).
    in property <bool> has-selection;
    in property <[bool]> active: [false, false, false, false, false];
    callback edited(string, int, int);
    callback cursor-moved(int, int);
    callback preedit(string);
    callback key(string, bool, bool, bool) -> bool;
    callback pointer(length, length, int); // 0 — нажатие, 1 — протягивание, 2 — двойной клик
    callback width(length);
    callback wheel(length);
    callback format(int); // 0–4 стиль, 5 ссылка, 6 убрать
    // Диалог ссылки.
    in-out property <bool> link-open;
    in-out property <string> link-url;
    callback link-apply(string);
}

export global Chat {
    in property <[DialogItem]> dialogs;
    // Фильтр списка (Дз-8) и поиск в шапке (В6).
    in property <string> filter-title;
    in property <[FolderItem]> folders;
    callback set-filter(int, int);
    in-out property <bool> search-active;
    in-out property <string> search-query;
    in property <[SearchRow]> search-rows;
    in property <bool> search-loading;
    callback search-edited(string);
    callback search-more();
    callback open-result(string, string);
    // Меню диалога и действия над чатом (Сп-4, Св-1).
    callback dialog-action(string, int);
    callback toggle-folder(string, int);
    in property <bool> action-confirm;
    in property <string> action-title;
    in property <string> action-text;
    in property <string> action-ok;
    in property <bool> action-can-revoke;
    in property <bool> action-revoke;
    in property <string> action-revoke-text;
    callback action-toggle-revoke();
    callback action-confirmed();
    callback action-cancel();
    // Правая панель: 0 нет, 1 сведения, 2 поиск по чату.
    in property <int> panel;
    callback show-panel(int);
    in property <string> info-status;
    in property <string> info-about;
    in property <string> info-username;
    in property <int> info-kind;
    in property <bool> info-muted;
    in property <bool> info-archived;
    in property <bool> info-blocked;
    in property <bool> info-self;
    in property <[MemberItem]> info-members;
    // Реклама в конце ленты (каналы и боты): одна строка, по щелчку — карточка.
    in property <string> sp-title;
    in property <string> sp-text;
    in property <string> sp-button;
    in property <string> sp-url;
    in property <bool> sp-expanded;
    in property <bool> sp-info-open;
    in property <string> sp-sponsor;
    in property <string> sp-additional;
    in property <string> sp-report-title;
    in property <[string]> sp-report-options;
    callback sp-toggle();
    callback sp-open();
    callback sp-info(bool);
    callback sp-hide();
    callback sp-report-pick(int);
    callback sp-report-cancel();
    // Вкладка сведений: 0 участники (или ничего), 1 медиа, 2 файлы, 3 ссылки, 4 голосовые.
    in property <int> shared-tab;
    in property <[SharedCell]> shared-cells;
    in property <[SharedRow]> shared-rows;
    in property <bool> shared-loading;
    in property <bool> shared-complete: true;
    callback shared-select(int);
    callback shared-open(int);
    callback shared-more();
    callback members-edited(string);
    in-out property <string> cs-query;
    in property <[SearchRow]> cs-rows;
    in property <string> cs-counter;
    in property <int> cs-filter;
    in property <int> cs-period;
    in property <string> cs-from-name;
    in property <[string]> cs-from-options;  // «Любой отправитель» и участники
    in property <string> open-id;
    in property <bool> cs-loading;
    callback cs-edited(string);
    callback cs-set-filter(int);
    callback cs-set-period(int);
    callback cs-set-from(string);
    callback cs-step(int);
    callback cs-open(string);
    callback cs-more();
    in property <bool> dialogs-loading;
    // История: строки до опоры и от неё, линия опоры (своя прокрутка, scroller.rs).
    in property <[MessageItem]> above;
    in property <[MessageItem]> below;
    in property <length> pivot;
    in property <bool> at-bottom: true;
    in property <int> unread-below;   // счётчик на кнопке «вниз»
    in property <bool> thumb-visible; // полоса прокрутки по хронологии
    in property <float> thumb;        // 0 — начало чата, 1 — конец
    in property <bool> has-open;
    in property <string> open-name;
    in property <string> open-status;
    in property <string> open-initials;
    in property <color> open-color;
    in property <image> open-avatar;
    in property <bool> open-has-avatar;
    in property <bool> history-loading;
    in property <bool> can-write: true;
    in property <bool> sending;
    in property <string> error;
    // Счётчик изменений истории: при росте — прокрутка вниз, если были внизу.
    callback open(string);
    callback back();
    callback send();
    callback scroll(float);
    callback view-height(float);
    callback row-height(int, float);
    callback jump-bottom();
    callback jump-to(string);
    callback thumb-release(float);
    in property <string> mono-family: "monospace";
    callback open-link(string);
    // Ссылка под текстом, который не совпадает с адресом: сначала спросить.
    in-out property <string> confirm-link;
    callback open-link-now(string);
    callback retry-send(string);
    callback delete-unsent(string);
    in-out property <bool> confirm-logout;
    callback log-out();
    // Контекстное меню сообщения (Чт-9).
    callback reply(string);
    callback edit(string);
    callback forward(string);
    callback ask-delete(string);
    callback pin(string);
    callback unpin(string);
    callback copy-text(string);
    callback copy-link(string);
    // Панель ответа или правки над полем.
    in property <int> compose-mode; // 0 обычный, 1 ответ, 2 правка
    in property <string> compose-title;
    in property <string> compose-text;
    callback cancel-compose();
    // Полоса закреплённого (Чт-14).
    in property <string> pinned-text;
    in property <string> pinned-counter;
    callback next-pinned();
    callback view-width(float);
    // Диалог выбора (Дз-16).
    in property <bool> picker-open;
    in property <bool> picker-forward;
    in property <[PickerItem]> picker-items;
    in property <int> picker-selected;
    in-out property <string> picker-query;
    callback new-chat();
    callback picker-query-edited(string);
    callback picker-toggle(string);
    callback picker-confirm();
    callback picker-close();
    // Удаление.
    in property <bool> delete-open;
    in property <bool> delete-can-revoke;
    in property <bool> delete-revoke;
    in property <int> delete-count;
    callback toggle-revoke();
    callback confirm-delete();
    callback cancel-delete();
    // Всплывающее сообщение (Со-3).
    in property <string> toast;
    // Вложения (В7): нажатие (просмотр, скачать, отмена, открыть), голос в опросе.
    callback media-click(string);
    callback vote(string, int);
    // Кадры GIF и кружков, играющих в ленте; кружок со звуком — его время.
    in property <[LiveFrame]> live;
    in property <string> sound-mid;
    in property <string> sound-time;
    // Отправка вложений (Св-4): панель подготовки над полем ввода, подпись — само поле.
    in property <bool> prepare-open;
    in property <string> prepare-title;
    in property <[PrepItem]> prepare-files;
    in property <bool> prepare-as-photo;
    in property <bool> prepare-can-photo;
    callback attach();
    callback prepare-more();
    callback prepare-photo(bool);
    callback prepare-remove(int);
    callback prepare-cancel();
    // Временный пункт меню до настроек (В9).
    callback clear-cache();
    callback open-settings();
}

component Avatar inherits Rectangle {
    in property <length> size: 48px;
    in property <string> initials;
    in property <color> tint;
    in property <image> source;
    in property <bool> has-image;
    width: size;
    height: size;
    // Круглая заливка работает и в software-рендерере; картинка уже круглая (маска в Rust).
    if !root.has-image: Rectangle {
        border-radius: root.size / 2;
        background: root.tint;
        Text {
            text: root.initials;
            color: Theme.text;
            font-size: root.size * 0.36;
            font-weight: 600;
        }
    }
    if root.has-image: Image {
        width: root.size;
        height: root.size;
        source: root.source;
    }
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked();
    height: 32px;
    border-radius: 4px;
    background: t.has-hover ? Theme.row-bg : transparent;
    accessible-role: button;
    accessible-label: text;
    t := TouchArea { clicked => { root.clicked(); } }
    Text {
        x: 10px;
        height: parent.height;
        text: root.text;
        color: root.danger ? Theme.error : Theme.text;
        font-size: 13px;
        vertical-alignment: center;
    }
}

component DialogRow inherits Rectangle {
    in property <DialogItem> item;
    callback clicked();
    property <length> menu-x;
    property <length> menu-y;
    height: 64px;
    background: item.selected ? Theme.row-selected : touch.has-hover ? Theme.row-bg : transparent;
    accessible-role: list-item;
    accessible-label: item.name;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.menu-x = self.mouse-x;
                root.menu-y = self.mouse-y;
                menu.show();
            }
        }
    }
    // «В папку…»: галочка — чат уже в папке; клик переключает.
    folders-menu := PopupWindow {
        x: min(root.menu-x, root.width - 240px);
        y: root.menu-y;
        width: 230px;
        Rectangle {
            background: Theme.card-bg;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.card-border;
            VerticalLayout {
                padding: 6px;
                for f[i] in Chat.folders: Rectangle {
                    property <bool> member: Math.mod(floor(root.item.folder-mask / pow(2, i - 1)), 2) == 1;
                    height: f.kind == 2 ? 32px : 0px;
                    visible: f.kind == 2;
                    border-radius: 4px;
                    background: fm.has-hover ? Theme.row-bg : transparent;
                    fm := TouchArea { clicked => { Chat.toggle-folder(root.item.id, f.id); } }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text { text: f.title; color: Theme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        if parent.member: Text { text: "✓"; color: Theme.link; font-size: 13px; vertical-alignment: center; }
                    }
                }
            }
        }
    }
    // Меню диалога (Сп-4): три группы, опасные — внизу и красным.
    menu := PopupWindow {
        x: min(root.menu-x, root.width - 240px);
        y: root.menu-y;
        width: 230px;
        Rectangle {
            background: Theme.card-bg;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.card-border;
            VerticalLayout {
                padding: 6px;
                if !root.item.archived: MenuItem {
                    text: root.item.pinned ? @tr("Unpin") : @tr("Pin");
                    clicked => { Chat.dialog-action(root.item.id, root.item.pinned ? 5 : 4); }
                }
                if !root.item.is-self: MenuItem {
                    text: root.item.muted ? @tr("Unmute") : @tr("Mute");
                    clicked => { Chat.dialog-action(root.item.id, root.item.muted ? 1 : 0); }
                }
                if !root.item.is-self: MenuItem {
                    text: root.item.archived ? @tr("Unarchive") : @tr("Archive");
                    clicked => { Chat.dialog-action(root.item.id, root.item.archived ? 3 : 2); }
                }
                Rectangle { height: 1px; background: Theme.card-border; }
                MenuItem {
                    text: root.item.unread > 0 || root.item.unread-mark ? @tr("Mark as read") : @tr("Mark as unread");
                    clicked => { Chat.dialog-action(root.item.id, root.item.unread > 0 || root.item.unread-mark ? 20 : 6); }
                }
                if Chat.folders.length > 1 && !(Chat.folders.length == 2 && Chat.folders[1].kind == 1): MenuItem {
                    text: @tr("Add to folder…");
                    clicked => { folders-menu.show(); }
                }
                Rectangle { height: 1px; background: Theme.card-border; }
                MenuItem { text: @tr("Clear history"); danger: true; clicked => { Chat.dialog-action(root.item.id, 7); } }
                if root.item.kind == 0 && !root.item.is-self: MenuItem {
                    text: @tr("Delete chat");
                    danger: true;
                    clicked => { Chat.dialog-action(root.item.id, 8); }
                }
                if root.item.kind != 0: MenuItem {
                    text: root.item.kind == 2 ? @tr("Leave channel") : @tr("Leave group");
                    danger: true;
                    clicked => { Chat.dialog-action(root.item.id, 9); }
                }
            }
        }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 10px;
        Avatar {
            y: 8px;
            initials: root.item.initials;
            tint: root.item.color;
            source: root.item.avatar;
            has-image: root.item.has-avatar;
        }
        VerticalLayout {
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 4px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.item.name;
                    color: Theme.text;
                    font-size: 14px;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                // «Без звука» (Сп-3): перечёркнутый динамик.
                if root.item.muted: Path {
                    width: 12px;
                    height: 12px;
                    y: 4px;
                    stroke: Theme.text-muted;
                    stroke-width: 1.3px;
                    viewbox-width: 12;
                    viewbox-height: 12;
                    commands: "M 1 4 L 4 4 L 7 1 L 7 11 L 4 8 L 1 8 Z M 9 4 L 12 8 M 12 4 L 9 8";
                }
                if root.item.out-state != 0: Text {
                    text: root.item.out-state == 2 ? "✓✓" : "✓";
                    color: root.item.selected ? Theme.text : Theme.link;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.item.time;
                    color: root.item.selected ? Theme.text : Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    if root.item.prefix != "": Text {
                        text: root.item.prefix;
                        color: root.item.selected ? Theme.text : Theme.text;
                        font-size: 12px;
                    }
                    Text {
                        text: root.item.preview;
                        color: root.item.selected ? Theme.text : root.item.preview-accent ? Theme.link : Theme.text-muted;
                        font-size: 12px;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                if root.item.unread > 0: Rectangle {
                    min-width: 22px;
                    height: 20px;
                    border-radius: 10px;
                    background: root.item.selected ? Theme.text : root.item.muted ? Theme.text-muted : Theme.success;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: root.item.unread > 999 ? "999+" : root.item.unread;
                            color: root.item.selected ? Theme.row-selected : Theme.window-bg;
                            font-size: 11px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.item.unread == 0 && root.item.unread-mark: Rectangle {
                    width: 14px;
                    height: 14px;
                    y: 3px;
                    border-radius: 7px;
                    background: root.item.muted ? Theme.text-muted : Theme.success;
                }
                if root.item.unread == 0 && !root.item.unread-mark && root.item.pinned: Path {
                    width: 12px;
                    height: 12px;
                    y: 4px;
                    stroke: Theme.text-muted;
                    stroke-width: 1.5px;
                    viewbox-width: 12;
                    viewbox-height: 12;
                    commands: "M 4 1 L 8 1 L 7 5 L 10 7 L 2 7 L 5 5 Z M 6 7 L 6 11";
                }
            }
        }
    }
}

// Строка результатов поиска: заголовок раздела, чат или сообщение.
component SearchResult inherits Rectangle {
    in property <SearchRow> item;
    callback clicked();
    height: item.header ? 30px : 58px;
    background: !item.header && t.has-hover ? Theme.row-bg : transparent;
    t := TouchArea {
        enabled: !root.item.header;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if root.item.header: Text {
        x: 12px;
        text: root.item.title;
        color: Theme.text-muted;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
        height: parent.height;
    }
    if !root.item.header: HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Avatar {
            y: 8px;
            size: 42px;
            initials: root.item.initials;
            tint: root.item.color;
            source: root.item.avatar;
            has-image: root.item.has-avatar;
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.item.title; color: Theme.text; font-size: 13px; overflow: elide; horizontal-stretch: 1; }
                Text { text: root.item.time; color: Theme.text-muted; font-size: 11px; }
            }
            if root.item.text != "": Text { text: root.item.text; color: Theme.text-muted; font-size: 12px; overflow: elide; }
        }
    }
}

// Тонкая полоса прокрутки для списков (вместо стандартной: та в покое еле
// видна, а при наведении становится широкой белой). Тот же вид, что у
// полосы чата: ползунок шире и ярче при наведении, перетаскивается.
component ThinScrollbar inherits Rectangle {
    in property <length> content;
    in property <length> view;
    in-out property <length> pos; // viewport-y списка (≤ 0)
    property <length> range: max(1px, root.content - root.view);
    property <length> th: max(28px, root.height * min(1, root.view / max(1px, root.content)));
    property <length> start;
    width: 10px;
    visible: root.content > root.view + 1px;
    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.start = -root.pos - self.mouse-y * root.range / max(1px, root.height - root.th);
            }
        }
        moved => {
            if (self.pressed) {
                root.pos = -max(0px, min(root.range, root.start + self.mouse-y * root.range / max(1px, root.height - root.th)));
            }
        }
    }
    Rectangle {
        x: ta.has-hover || ta.pressed ? 2px : 4px;
        width: ta.has-hover || ta.pressed ? 6px : 4px;
        y: (-root.pos) / root.range * (root.height - root.th);
        height: root.th;
        border-radius: 3px;
        background: ta.pressed ? Theme.link : ta.has-hover ? Theme.thumb-hover : Theme.thumb;
    }
}

component DialogList inherits Rectangle {
    background: Theme.window-bg;
    VerticalLayout {
        // Шапка списка: меню, фильтр папок (В6), поиск (В6), новый чат (В5).
        HorizontalLayout {
            height: 52px;
            padding: 8px;
            spacing: 8px;
            Rectangle {
                width: 44px;
                border-radius: Theme.radius;
                background: menu-touch.has-hover ? Theme.row-selected : Theme.row-bg;
                border-width: 1px;
                border-color: Theme.card-border;
                accessible-role: button;
                accessible-label: @tr("Menu");
                menu-touch := TouchArea { clicked => { menu-pop.show(); } }
                Path {
                    width: 16px;
                    height: 12px;
                    stroke: Theme.text;
                    stroke-width: 1.5px;
                    viewbox-width: 16;
                    viewbox-height: 12;
                    commands: "M 0 1 L 16 1 M 0 6 L 16 6 M 0 11 L 16 11";
                }
            }
            // Фильтр папок (Дз-8): «Все чаты», папки, «Архив».
            if !Chat.search-active: Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.radius;
                background: filter-touch.has-hover ? Theme.row-bg : transparent;
                accessible-role: button;
                accessible-label: Chat.filter-title;
                filter-touch := TouchArea { clicked => { filter-pop.show(); } }
                HorizontalLayout {
                    padding-left: 6px;
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: Chat.filter-title;
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Path {
                        width: 10px;
                        height: 6px;
                        y: (parent.height - self.height) / 2;
                        stroke: Theme.text-muted;
                        stroke-width: 1.5px;
                        viewbox-width: 10;
                        viewbox-height: 6;
                        commands: "M 1 1 L 5 5 L 9 1";
                    }
                }
            }
            // Поиск в шапке (Сп, Дз): поле заменяет фильтр, результаты — список.
            if Chat.search-active: search-field := Field {
                // Вся ширина шапки без кнопок меню и закрытия.
                field-width: root.width - 112px;
                placeholder: @tr("Search");
                text <=> Chat.search-query;
                init => { self.focus-input(); }
                edited(t) => { Chat.search-edited(t); }
                escape => { Chat.search-active = false; Chat.search-query = ""; Chat.search-edited(""); }
            }
            Rectangle {
                width: 36px;
                border-radius: Theme.radius;
                background: search-touch.has-hover ? Theme.row-bg : transparent;
                accessible-role: button;
                accessible-label: Chat.search-active ? @tr("Close search") : @tr("Search");
                search-touch := TouchArea {
                    clicked => {
                        if (Chat.search-active) {
                            Chat.search-active = false;
                            Chat.search-query = "";
                            Chat.search-edited("");
                        } else {
                            Chat.search-active = true;
                        }
                    }
                }
                if !Chat.search-active: Path {
                    width: 16px;
                    height: 16px;
                    stroke: Theme.text;
                    stroke-width: 1.6px;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    commands: "M 6.5 1.5 A 5 5 0 1 1 6.49 1.5 Z M 10 10 L 15 15";
                }
                if Chat.search-active: Path {
                    width: 12px;
                    height: 12px;
                    stroke: Theme.text-muted;
                    stroke-width: 1.5px;
                    viewbox-width: 12;
                    viewbox-height: 12;
                    commands: "M 1 1 L 11 11 M 11 1 L 1 11";
                }
            }
            // «Новый чат» (Дз-11).
            if !Chat.search-active: Rectangle {
                width: 44px;
                border-radius: Theme.radius;
                background: new-touch.has-hover ? Theme.accent-hover : Theme.accent;
                border-width: 1px;
                border-color: Theme.accent-border;
                accessible-role: button;
                accessible-label: @tr("New chat");
                new-touch := TouchArea { clicked => { Chat.new-chat(); } }
                Path {
                    width: 16px;
                    height: 16px;
                    stroke: Theme.text;
                    stroke-width: 1.8px;
                    viewbox-width: 16;
                    viewbox-height: 16;
                    commands: "M 8 2 L 8 14 M 2 8 L 14 8";
                }
            }
        }
        property <bool> searching: Chat.search-active && Chat.search-query != "";
        if searching: Rectangle {
            vertical-stretch: 1;
            if Chat.search-rows.length == 0: Text {
                text: Chat.search-loading ? @tr("Searching…") : @tr("Nothing found");
                color: Theme.text-muted;
                font-size: 13px;
            }
            sl := ListView {
                vertical-scrollbar-policy: always-off;
                for r in Chat.search-rows: SearchResult { item: r; clicked => { Chat.open-result(r.peer, r.msg); } }
                changed viewport-y => {
                    if (self.content-y < self.visible-height - self.content-height + 200px) {
                        Chat.search-more();
                    }
                }
            }
            ThinScrollbar {
                x: parent.width - self.width;
                height: parent.height;
                content: sl.content-height;
                view: sl.visible-height;
                pos <=> sl.content-y;
            }
        }
        if !searching && Chat.dialogs.length == 0: Rectangle {
            vertical-stretch: 1;
            Text {
                text: Chat.dialogs-loading ? @tr("Loading…") : Chat.filter-title == @tr("All chats") ? @tr("No chats yet")
                    : @tr("No chats in this folder yet");
                color: Theme.text-muted;
                font-size: 13px;
            }
        }
        if !searching && Chat.dialogs.length > 0: Rectangle {
            vertical-stretch: 1;
            dl := ListView {
                vertical-scrollbar-policy: always-off;
                for d in Chat.dialogs: DialogRow {
                    item: d;
                    clicked => { Chat.open(d.id); }
                }
            }
            ThinScrollbar {
                x: parent.width - self.width;
                height: parent.height;
                content: dl.content-height;
                view: dl.visible-height;
                pos <=> dl.content-y;
            }
        }
    }
    // Всплывающие меню закрываются щелчком мимо и не накладываются друг на друга.
    filter-pop := PopupWindow {
        x: 56px;
        y: 50px;
        width: 250px;
        Rectangle {
        height: filters.preferred-height;
        background: Theme.card-bg;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.card-border;
        filters := VerticalLayout {
            padding: 6px;
            for f in Chat.folders: Rectangle {
                height: 36px;
                border-radius: 4px;
                background: f.selected ? Theme.row-selected : ft.has-hover ? Theme.row-bg : transparent;
                ft := TouchArea { clicked => { Chat.set-filter(f.kind, f.id); } }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text { text: f.title; color: Theme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    if f.unread > 0: Text { text: f.unread; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
                }
            }
        }
        }
    }
    menu-pop := PopupWindow {
        x: 8px;
        y: 56px;
        width: 220px;
        Rectangle {
        height: menu.preferred-height;
        background: Theme.card-bg;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.card-border;
        menu := VerticalLayout {
            padding: 6px;
            Rectangle {
                height: 36px;
                border-radius: 4px;
                background: set-touch.has-hover ? Theme.row-bg : transparent;
                set-touch := TouchArea { clicked => { Chat.open-settings(); } }
                Text {
                    x: 10px;
                    text: @tr("Settings");
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                    height: parent.height;
                }
            }
            Rectangle {
                height: 36px;
                border-radius: 4px;
                background: out-touch.has-hover ? Theme.row-bg : transparent;
                out-touch := TouchArea { clicked => { Chat.confirm-logout = true; } }
                Text {
                    x: 10px;
                    text: @tr("Log out");
                    color: Theme.error;
                    font-size: 13px;
                    vertical-alignment: center;
                    height: parent.height;
                }
            }
        }
        }
    }
}

// Время и галочки — только при наведении, снаружи пузыря (Чт-4, Чт-5);
// «изм.», очередь отправки и «прочитано» у последнего своего — всегда (Чт-6).
component Meta inherits HorizontalLayout {
    in property <MessageItem> item;
    in property <bool> hover;
    spacing: 3px;
    alignment: end;
    if root.item.send-state == 1 || root.item.send-state == 2: Path {
        // часы
        width: 11px;
        height: 11px;
        y: 2px;
        stroke: Theme.text-muted;
        stroke-width: 1.2px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 6 1 A 5 5 0 1 1 5.99 1 Z M 6 3 L 6 6 L 8 7.5";
    }
    if root.item.send-state == 3: Rectangle {
        width: 14px;
        height: 14px;
        y: 1px;
        border-radius: 7px;
        background: Theme.error;
        Text { text: "!"; color: Theme.on-link; font-size: 10px; font-weight: 700; }
    }
    if root.hover && root.item.send-state == 0: Text {
        text: root.item.time;
        color: Theme.text-muted;
        font-size: 10px;
        vertical-alignment: bottom;
    }
    if root.item.out && root.item.send-state == 0 && (root.hover || root.item.last-read): Text {
        text: root.item.read ? "✓✓" : "✓";
        color: root.item.read ? Theme.link : Theme.text-muted;
        font-size: 10px;
        vertical-alignment: bottom;
    }
}

// Текстовый сегмент со стилем: начертание, подчёркивание и зачёркивание
// линиями (у Text их нет), моноширинный с подложкой, ссылка — цветом и кликом.
component RichText inherits Rectangle {
    in property <RichSeg> seg;
    width: t.preferred-width;
    background: seg.mono ? Theme.mono-bg : transparent;
    border-radius: 3px;
    t := Text {
        x: 0;
        height: parent.height;
        text: root.seg.text;
        color: root.seg.link != "" ? Theme.link : Theme.text;
        font-size: Theme.msg-size;
        font-weight: root.seg.bold ? 700 : 400;
        font-italic: root.seg.italic;
        font-family: root.seg.mono ? Chat.mono-family : "";
        vertical-alignment: center;
    }
    if root.seg.underline || root.seg.link != "": Rectangle {
        y: parent.height / 2 + 7px;
        height: 1px;
        background: t.color;
    }
    if root.seg.strike: Rectangle {
        y: parent.height / 2;
        height: 1px;
        background: t.color;
    }
    if root.seg.link != "": TouchArea {
        mouse-cursor: pointer;
        clicked => { Chat.open-link(root.seg.link); }
    }
}

// Строки текста с эмодзи-картинками и стилями (раскладка — в Rust, О-14).
component RichLines inherits VerticalLayout {
    in property <[RichLine]> lines;
    for line in root.lines: HorizontalLayout {
        height: Theme.msg-line;
        alignment: start;
        for seg in line.segs: HorizontalLayout {
            // Эмодзи в ячейке на 2 px шире (спайк О-14); размер — от настройки.
            padding: seg.emoji ? 1px : 0px;
            if seg.emoji: Image { source: seg.image; width: Theme.msg-emoji; height: Theme.msg-emoji; }
            if !seg.emoji: RichText { seg: seg; }
        }
    }
}

// Картинка вложения: скачанное или размытое мини-превью, поверх — «играть»,
// длительность и ход скачивания.
component MediaImage inherits Rectangle {
    in property <image> img;
    in property <bool> has-img;
    in property <bool> play;
    in property <string> dur;
    in property <string> id;
    in property <int> state;
    in property <float> progress;
    in property <bool> round;
    in property <bool> gif;
    border-radius: root.round ? self.width / 2 : 10px;
    background: root.has-img ? transparent : Theme.soft;
    clip: true;
    if root.has-img: Image { source: root.img; width: parent.width; height: parent.height; image-fit: fill; }
    // Кадр, играющий в ленте, — поверх превью (маска уже наложена в Rust).
    for lf in Chat.live: Image {
        visible: lf.mid == root.id;
        source: lf.img;
        width: parent.width;
        height: parent.height;
        image-fit: fill;
    }
    if root.gif: Rectangle {
        x: 6px;
        y: 6px;
        width: gif-text.preferred-width + 12px;
        height: 18px;
        border-radius: 9px;
        background: #00000090;
        gif-text := Text { text: "GIF"; color: white; font-size: 10px; font-weight: 600; }
    }
    // Кружок: «без звука» сверху, пока играет сам; длительность или ход внизу.
    if root.round && Chat.sound-mid != root.id: Rectangle {
        y: 10px;
        width: 26px;
        height: 26px;
        border-radius: 13px;
        background: #00000090;
        Path {
            width: 14px;
            height: 12px;
            fill: white;
            stroke: white;
            stroke-width: 1.2px;
            viewbox-width: 14;
            viewbox-height: 12;
            commands: "M 1 4 L 4 4 L 7 1 L 7 11 L 4 8 L 1 8 Z M 9 4 L 13 8 M 13 4 L 9 8";
        }
    }
    if root.round: Rectangle {
        x: 18px;
        y: parent.height - 30px;
        width: round-dur.preferred-width + 14px;
        height: 20px;
        border-radius: 10px;
        background: #00000090;
        round-dur := Text {
            text: Chat.sound-mid == root.id ? Chat.sound-time : root.dur;
            color: white;
            font-size: 11px;
        }
    }
    if root.play: Rectangle {
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: #000000a0;
        Path {
            width: 16px;
            height: 18px;
            x: 16px;
            fill: white;
            viewbox-width: 16;
            viewbox-height: 18;
            commands: "M 0 0 L 16 9 L 0 18 Z";
        }
    }
    if root.dur != "" && !root.round && !root.gif: Rectangle {
        x: 6px;
        y: 6px;
        width: dur-text.preferred-width + 10px;
        height: 18px;
        border-radius: 9px;
        background: #000000a0;
        dur-text := Text { text: root.dur; color: white; font-size: 10px; }
    }
    if root.state == 1: Rectangle {
        y: parent.height - 4px;
        height: 4px;
        width: parent.width * root.progress;
        x: 0;
        background: Theme.link;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { Chat.media-click(root.id); }
    }
}

component MediaBlock inherits VerticalLayout {
    in property <MessageItem> item;
    spacing: 4px;
    if root.item.mkind == 1: MediaImage {
        width: root.item.mw;
        height: root.item.mh;
        img: root.item.mimg;
        has-img: root.item.mhas-img;
        play: root.item.mplay;
        dur: root.item.mdur;
        id: root.item.mid;
        state: root.item.file-state;
        progress: root.item.file-progress;
        round: root.item.mround;
        gif: root.item.mgif;
    }
    if root.item.mkind == 5: Rectangle {
        width: root.item.mw;
        height: root.item.mh;
        for c in root.item.album: MediaImage {
            x: c.x;
            y: c.y;
            width: c.w;
            height: c.h;
            img: c.img;
            has-img: c.has-img;
            play: c.play;
            id: c.id;
        }
    }
    // Файл, голосовое, аудио: кнопка (скачать / отмена / открыть), имя, размер или ход.
    if root.item.mkind == 2: HorizontalLayout {
        spacing: 10px;
        min-width: 220px;
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: Theme.link;
            Text {
                text: root.item.file-state == 0 ? "↓" : root.item.file-state == 1 ? "✕" : root.item.file-state == 3 ? "❚❚"
                    : root.item.file-voice ? "▶" : "≡";
                color: Theme.on-link;
                font-size: 18px;
                font-weight: 700;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { Chat.media-click(root.item.mid); }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text { text: root.item.file-name; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
            if root.item.file-state == 1 || root.item.file-state >= 3: Rectangle {
                height: 3px;
                background: Theme.soft-strong;
                border-radius: 1px;
                Rectangle { x: 0; width: parent.width * root.item.file-progress; background: Theme.link; border-radius: 1px; }
            }
            Text { text: root.item.file-info; color: Theme.text-muted; font-size: 11px; }
        }
    }
    // Превью ссылки (Чт-12): полоса слева, сайт, заголовок, описание, картинка.
    if root.item.mkind == 3: HorizontalLayout {
        spacing: 8px;
        Rectangle { width: 3px; background: Theme.link; border-radius: 1px; }
        VerticalLayout {
            spacing: 2px;
            if root.item.wp-site != "": Text { text: root.item.wp-site; color: Theme.link; font-size: 12px; font-weight: 600; }
            if root.item.wp-title != "": Text { text: root.item.wp-title; color: Theme.text; font-size: 12px; font-weight: 600; wrap: word-wrap; }
            if root.item.wp-desc != "": Text { text: root.item.wp-desc; color: Theme.text; font-size: 12px; wrap: word-wrap; }
            if root.item.mhas-img: MediaImage {
                width: root.item.mw;
                height: root.item.mh;
                img: root.item.mimg;
                has-img: true;
                id: root.item.mid;
            }
        }
    }
    // Опрос (Чт-13): до голоса — варианты кнопками; после — доли полосами.
    if root.item.mkind == 4: VerticalLayout {
        spacing: 6px;
        min-width: 260px;
        if !root.item.poll-qrich: Text { text: root.item.poll-question; color: Theme.text; font-size: 13px; font-weight: 600; wrap: word-wrap; }
        if root.item.poll-qrich: RichLines { lines: root.item.poll-qlines; }
        Text { text: root.item.poll-info; color: Theme.text-muted; font-size: 11px; }
        for o[i] in root.item.poll-options: Rectangle {
            height: o.rich ? max(32px, o.lines.length * 20px + 12px) : 32px;
            border-radius: 6px;
            border-width: root.item.poll-voted ? 0px : 1px;
            border-color: Theme.card-border;
            background: !root.item.poll-voted && ta.has-hover ? Theme.soft : transparent;
            if root.item.poll-voted: Rectangle {
                x: 0;
                width: parent.width * o.share;
                border-radius: 6px;
                background: o.correct ? Theme.poll-correct : o.chosen ? Theme.poll-chosen : Theme.soft-strong;
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                if root.item.poll-voted: Text {
                    text: o.percent;
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                    width: 36px;
                }
                if o.chosen: Text { text: "✓"; color: Theme.link; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                if !o.rich: Text {
                    text: o.text;
                    color: Theme.text;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if o.rich: VerticalLayout {
                    alignment: center;
                    RichLines { lines: o.lines; }
                }
            }
            ta := TouchArea {
                enabled: !root.item.poll-voted;
                mouse-cursor: self.enabled ? pointer : default;
                clicked => { Chat.vote(root.item.id, i); }
            }
        }
    }
}

component Bubble inherits VerticalLayout {
    in property <MessageItem> item;
    in property <bool> hover;
    padding-left: 12px;
    padding-right: 12px;
    spacing: 3px;
    // Строка: [время] пузырь [время] — время снаружи на уровне последней строки (Чт-5).
    HorizontalLayout {
        alignment: root.item.out ? end : start;
        spacing: 6px;
        if root.item.out: VerticalLayout {
            alignment: end;
            padding-bottom: 6px;
            Meta { item: root.item; hover: root.hover; }
        }
        bub := Rectangle {
            property <bool> big: root.item.big-emoji.length > 0 && root.item.send-state != 3;
            // Фото, видео, альбом — пузырь шириной с вложение, подпись под ним
            // переносится по этой ширине (Чт-11); превью ссылки — с карточку.
            property <bool> visual: root.item.mkind == 1 || root.item.mkind == 5;
            // Кружок и GIF без подписи — без пузыря, как в Telegram.
            property <bool> bare: (root.item.mround || root.item.mgif) && root.item.text == "";
            property <length> full: min(480px, root.width * 0.75);
            property <length> fit: self.visual ? root.item.mw + 8px
                : root.item.mkind == 3 && root.item.mhas-img ? min(self.full, root.item.mw + 39px) : 0px;
            property <length> inset: self.visual ? 6px : 0px;
            max-width: self.fit > 0 ? self.fit : self.full;
            min-width: self.fit;
            background: self.big || self.bare ? transparent : root.item.send-state == 3 ? Theme.bubble-error : root.item.out ? Theme.bubble-out : Theme.bubble-in;
            border-radius: 10px;
            border-width: self.big || self.bare ? 0px : 1px;
            border-color: root.item.send-state == 3 ? Theme.error : root.item.out ? Theme.bubble-out-border : Theme.bubble-in-border;
            VerticalLayout {
                padding: bub.visual ? 4px : 8px;
                padding-left: bub.visual ? 4px : 10px;
                padding-right: bub.visual ? 4px : 10px;
                spacing: bub.visual ? 4px : 2px;
                if (root.item.sender != "" && root.item.first-in-series) || root.item.fwd-name != ""
                    || root.item.reply-author != "" || root.item.reply-text != "": VerticalLayout {
                    padding-left: bub.inset;
                    padding-right: bub.inset;
                    padding-top: bub.visual ? 3px : 0px;
                    spacing: 3px;
                    if root.item.sender != "" && root.item.first-in-series: Text {
                        text: root.item.sender;
                        color: root.item.sender-color;
                        font-size: 12px;
                        font-weight: 600;
                    }
                    // Пересланное (Чт-2): две строки — пометка и источник крупнее, со стрелкой.
                    if root.item.fwd-name != "": HorizontalLayout {
                        spacing: 6px;
                        Path {
                            width: 14px;
                            height: 12px;
                            y: 3px;
                            stroke: Theme.link;
                            stroke-width: 1.6px;
                            viewbox-width: 14;
                            viewbox-height: 12;
                            commands: "M 8 1 L 13 5.5 L 8 10 M 13 5.5 L 6 5.5 A 5 5 0 0 0 1 10.5";
                        }
                        VerticalLayout {
                            Text { text: @tr("Forwarded from"); color: Theme.text-muted; font-size: 11px; }
                            Text { text: root.item.fwd-name; color: Theme.link; font-size: 13px; font-weight: 700; overflow: elide; }
                        }
                    }
                    if root.item.reply-author != "" || root.item.reply-text != "": Rectangle {
                        height: quote.preferred-height;
                        // Клик по цитате — к исходному сообщению сменой окна (Дз, Чт-3).
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Chat.jump-to(root.item.reply-id); }
                        }
                        quote := HorizontalLayout {
                            spacing: 6px;
                            Rectangle { width: 3px; background: root.item.reply-color; border-radius: 1px; }
                            VerticalLayout {
                                Text { text: root.item.reply-author; color: root.item.reply-color; font-size: 11px; font-weight: 600; overflow: elide; }
                                Text { text: root.item.reply-text; color: Theme.reply-text; font-size: 11px; overflow: elide; }
                            }
                        }
                    }
                }
                if root.item.mkind != 0 && root.item.mkind != 3: MediaBlock { item: root.item; }
                if root.item.media != "" && root.item.mkind == 0: Text {
                    text: root.item.media;
                    color: Theme.link;
                    font-size: 13px;
                    font-italic: true;
                }
                if root.item.big-emoji.length > 0: HorizontalLayout {
                    alignment: root.item.out ? end : start;
                    spacing: 4px;
                    for e in root.item.big-emoji: Image { source: e; width: 48px; height: 48px; }
                }
                if root.item.text != "" && root.item.big-emoji.length == 0: VerticalLayout {
                    padding-left: bub.inset;
                    padding-right: bub.inset;
                    if !root.item.rich: Text {
                        text: root.item.text;
                        color: Theme.text;
                        font-size: Theme.msg-size;
                        wrap: word-wrap;
                    }
                    if root.item.rich: RichLines { lines: root.item.lines; }
                }
                // Превью ссылки — под текстом сообщения, как в Telegram.
                if root.item.mkind == 3: MediaBlock { item: root.item; }
                if root.item.edited: HorizontalLayout {
                    alignment: end;
                    padding-right: bub.inset;
                    padding-bottom: bub.visual ? 2px : 0px;
                    Text { text: @tr("edited"); color: Theme.text-muted; font-size: 10px; }
                }
            }
        }
        if !root.item.out: VerticalLayout {
            alignment: end;
            padding-bottom: 6px;
            Meta { item: root.item; hover: root.hover; }
        }
    }
    if root.item.send-state == 1 || root.item.send-state == 2: Text {
        text: @tr("sending…");
        color: Theme.text-muted;
        font-size: 10px;
        horizontal-alignment: root.item.out ? right : left;
    }
    if root.item.send-state == 3: VerticalLayout {
        spacing: 2px;
        Text {
            text: root.item.send-error;
            color: Theme.error;
            font-size: 10px;
            horizontal-alignment: right;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 12px;
            Link { text: @tr("Retry"); font-size: 11px; clicked => { Chat.retry-send(root.item.local-id); } }
            Link { text: @tr("Delete"); font-size: 11px; clicked => { Chat.delete-unsent(root.item.local-id); } }
        }
    }
}


// Реклама одной строкой (решение пользователя: тише, чем в официальном
// клиенте): «Реклама · заголовок · текст…», ⓘ и ✕; по щелчку — карточка.
component SponsoredRow inherits HorizontalLayout {
    padding-left: 12px;
    padding-right: 12px;
    Rectangle {
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.card-border;
        background: ta.has-hover && !Chat.sp-expanded ? Theme.soft : transparent;
        ta := TouchArea { mouse-cursor: pointer; clicked => { Chat.sp-toggle(); } }
        VerticalLayout {
            padding-left: 10px;
            padding-right: 8px;
            padding-top: 5px;
            padding-bottom: 5px;
            spacing: 4px;
            HorizontalLayout {
                spacing: 6px;
                height: 18px;
                Text { text: @tr("Ad"); color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
                Text { text: "·"; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
                Text { text: Chat.sp-title; color: Theme.text-muted; font-size: 12px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                if !Chat.sp-expanded: Text {
                    text: Chat.sp-text;
                    color: Theme.text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if Chat.sp-expanded: Rectangle { horizontal-stretch: 1; }
                Link { text: "ⓘ"; font-size: 12px; color: Theme.text-muted; vertical-alignment: center; clicked => { Chat.sp-info(true); } }
                Link { text: "✕"; font-size: 12px; color: Theme.text-muted; vertical-alignment: center; clicked => { Chat.sp-hide(); } }
            }
            if Chat.sp-expanded: Text { text: Chat.sp-text; color: Theme.text; font-size: 12px; wrap: word-wrap; }
            if Chat.sp-expanded && Chat.sp-url != "": HorizontalLayout {
                alignment: start;
                Link {
                    text: (Chat.sp-button != "" ? Chat.sp-button : @tr("Open")) + " →";
                    font-size: 12px;
                    clicked => { Chat.sp-open(); }
                }
            }
        }
    }
}

component MessageRow inherits VerticalLayout {
    in property <MessageItem> item;
    property <length> menu-x;
    property <length> menu-y;
    padding-top: item.first-in-series ? 6px : 2px;
    padding-bottom: 2px;
    spacing: 6px;
    // Высота после раскладки — прокрутке (края и видимые строки). Не из init:
    // там строка ещё не разложена (8 px — одни отступы), и прокрутка решала,
    // что история короче окна, прижимая вид к низу. Новая строка и строка с
    // другим сообщением меряются следующим проходом цикла (таймер), когда
    // раскладка готова; дальнейшие изменения — через changed height.
    property <bool> measure: true;
    changed item => { self.measure = true; }
    Timer {
        interval: 1ms;
        running: root.measure;
        triggered => {
            root.measure = false;
            Chat.row-height(root.item.key, root.height / 1px);
        }
    }
    changed height => { Chat.row-height(root.item.key, self.height / 1px); }
    if root.item.date-label != "": HorizontalLayout {
        alignment: center;
        padding-top: 6px;
        Rectangle {
            height: 22px;
            width: date-text.preferred-width + 20px;
            background: Theme.row-bg;
            border-radius: 11px;
            border-width: 1px;
            border-color: Theme.card-border;
            date-text := Text { text: root.item.date-label; color: Theme.text; font-size: 11px; }
        }
    }
    if root.item.unread-divider: Rectangle {
        height: 26px;
        background: Theme.card-bg;
        Text { text: @tr("New messages"); color: Theme.link; font-size: 12px; }
    }
    if root.item.service: HorizontalLayout {
        alignment: center;
        Rectangle {
            height: 24px;
            width: min(service-text.preferred-width + 20px, 420px);
            background: Theme.row-bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.card-border;
            service-text := Text {
                text: root.item.text;
                color: Theme.text;
                font-size: 11px;
                overflow: elide;
                width: parent.width - 16px;
                horizontal-alignment: center;
            }
        }
    }
    if root.item.sponsored: SponsoredRow { }
    if !root.item.service && !root.item.sponsored: Rectangle {
        height: bubble.preferred-height;
        hover-area := TouchArea {
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up && root.item.id != "") {
                    root.menu-x = self.mouse-x;
                    root.menu-y = self.mouse-y;
                    menu.show();
                }
            }
        }
        bubble := Bubble { width: 100%; item: root.item; hover: hover-area.has-hover; }
        menu := PopupWindow {
            x: min(root.menu-x, root.width - 230px);
            y: root.menu-y;
            width: 220px;
            Rectangle {
                background: Theme.card-bg;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.card-border;
                VerticalLayout {
                    padding: 6px;
                    if root.item.text != "": MenuItem { text: @tr("Copy text"); clicked => { Chat.copy-text(root.item.id); } }
                    MenuItem { text: @tr("Reply"); clicked => { Chat.reply(root.item.id); } }
                    MenuItem { text: @tr("Forward"); clicked => { Chat.forward(root.item.id); } }
                    if root.item.can-edit: MenuItem { text: @tr("Edit"); clicked => { Chat.edit(root.item.id); } }
                    MenuItem {
                        text: root.item.pinned ? @tr("Unpin") : @tr("Pin");
                        clicked => { if (root.item.pinned) { Chat.unpin(root.item.id); } else { Chat.pin(root.item.id); } }
                    }
                    if root.item.has-link: MenuItem { text: @tr("Copy link"); clicked => { Chat.copy-link(root.item.id); } }
                    if root.item.can-delete: MenuItem { text: @tr("Delete"); danger: true; clicked => { Chat.ask-delete(root.item.id); } }
                }
            }
        }
    }
}

// Переключатель «один из» (как фото / как файл).
component Radio inherits HorizontalLayout {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback clicked();
    spacing: 6px;
    Rectangle {
        width: 16px;
        height: 16px;
        y: 2px;
        border-radius: 8px;
        border-width: 1.5px;
        border-color: root.enabled ? (root.checked ? Theme.link : Theme.text-muted) : Theme.card-border;
        if root.checked: Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.link; }
    }
    Text {
        text: root.text;
        color: root.enabled ? Theme.text : Theme.text-muted;
        font-size: 12px;
        vertical-alignment: center;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: self.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Кнопка панели форматирования.
component FmtButton inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <bool> bold;
    in property <bool> italic;
    in property <bool> underline;
    in property <bool> strike;
    in property <bool> mono;
    callback clicked();
    width: max(32px, t.preferred-width + 16px);
    height: 32px;
    border-radius: 4px;
    background: root.on ? Theme.accent : ta.has-hover ? Theme.row-bg : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    t := Text {
        text: root.label;
        color: Theme.text;
        font-size: 13px;
        font-weight: root.bold ? 700 : 400;
        font-italic: root.italic;
        font-family: root.mono ? Chat.mono-family : "";
    }
    if root.underline: Rectangle { x: t.x; y: t.y + t.height - 5px; width: t.width; height: 1px; background: Theme.text; }
    if root.strike: Rectangle { x: t.x; y: t.y + t.height / 2; width: t.width; height: 1px; background: Theme.text; }
}

component ComposerField inherits Rectangle {
    in property <bool> enabled: true;
    property <bool> blink: true;
    property <length> menu-x;
    property <length> menu-y;
    // Вызовы Rust → TextInput (выделение) — по смене номера.
    property <int> seq: Composer.sel-seq;
    changed seq => { ti.set-selection-offsets(Composer.sel-anchor, Composer.sel-cursor); }
    // Диалог ссылки закрыт — фокус обратно в поле.
    property <bool> link-open: Composer.link-open;
    changed link-open => {
        if (!self.link-open) {
            ti.focus();
        }
    }
    init => { Composer.width(self.width); }
    changed width => { Composer.width(self.width); }
    height: min(Composer.content-height, 160px);
    clip: true;
    ti := TextInput {
        x: 0;
        y: -Composer.scroll-y;
        width: parent.width;
        height: max(parent.height, Composer.content-height);
        text <=> Composer.text;
        // Невидимый движок: текст, выделение и каретку рисует наш слой.
        color: transparent;
        selection-background-color: transparent;
        selection-foreground-color: transparent;
        text-cursor-width: 0px;
        font-size: 13px;
        wrap: word-wrap;
        single-line: false;
        enabled: root.enabled;
        accessible-label: @tr("Message");
        edited => { Composer.edited(self.text, self.cursor-position-byte-offset, self.anchor-position-byte-offset); }
        cursor-position-changed(p) => {
            root.blink = true;
            Composer.cursor-moved(self.cursor-position-byte-offset, self.anchor-position-byte-offset);
        }
        changed preedit-text => { Composer.preedit(self.preedit-text); }
        key-pressed(e) => {
            if (e.text == Key.Escape && Chat.compose-mode != 0) {
                Chat.cancel-compose();
                return accept;
            }
            if (Composer.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt)) {
                return accept;
            }
            reject
        }
    }
    Rectangle {
        y: -Composer.scroll-y;
        for r in Composer.selection: Rectangle {
            x: r.x;
            y: r.y;
            width: r.w;
            height: r.h;
            background: #6ab3f350;
        }
        VerticalLayout {
            alignment: start;
            for line in Composer.lines: HorizontalLayout {
                height: 20px;
                alignment: start;
                for seg in line.segs: HorizontalLayout {
                    padding: seg.emoji ? 1px : 0px;
                    if seg.emoji: Image { source: seg.image; width: 18px; height: 18px; }
                    if !seg.emoji: RichText { seg: seg; }
                }
            }
        }
        if ti.has-focus && root.blink: Rectangle {
            x: Composer.caret-x;
            y: Composer.caret-y + 2px;
            width: 1.5px;
            height: 16px;
            background: Theme.text;
        }
    }
    if Composer.text == "" && ti.preedit-text == "": Text {
        text: @tr("Write a message…");
        color: Theme.text-muted;
        font-size: 13px;
        x: 0;
        y: 0;
        height: 20px;
        vertical-alignment: center;
    }
    Timer {
        interval: 530ms;
        running: ti.has-focus;
        triggered => { root.blink = !root.blink; }
    }
    // Мышь — по нашей раскладке (у строк с эмодзи геометрия TextInput другая).
    TouchArea {
        mouse-cursor: text;
        enabled: root.enabled;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                ti.focus();
                Composer.pointer(self.mouse-x, self.mouse-y + Composer.scroll-y, 0);
            }
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                ti.focus();
                root.menu-x = self.mouse-x;
                root.menu-y = self.mouse-y;
                fmt.show();
            }
        }
        moved => {
            if (self.pressed) {
                Composer.pointer(self.mouse-x, self.mouse-y + Composer.scroll-y, 1);
            }
        }
        double-clicked => { Composer.pointer(self.mouse-x, self.mouse-y + Composer.scroll-y, 2); }
        scroll-event(e) => {
            if (Composer.content-height > root.height) {
                Composer.wheel(e.delta-y);
                return accept;
            }
            reject
        }
    }
    // Панель форматирования по правой кнопке (Дз-9, Дз-15).
    fmt := PopupWindow {
        x: max(0, min(root.menu-x - 150px, root.width - 330px));
        y: root.menu-y - 52px;
        Rectangle {
            background: Theme.card-bg;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.card-border;
            HorizontalLayout {
                padding: 6px;
                spacing: 2px;
                FmtButton { label: "Ж"; bold: true; on: Composer.active[0]; clicked => { Composer.format(0); } }
                FmtButton { label: "К"; italic: true; on: Composer.active[1]; clicked => { Composer.format(1); } }
                FmtButton { label: "П"; underline: true; on: Composer.active[2]; clicked => { Composer.format(2); } }
                FmtButton { label: "З"; strike: true; on: Composer.active[3]; clicked => { Composer.format(3); } }
                FmtButton { label: "<>"; mono: true; on: Composer.active[4]; clicked => { Composer.format(4); } }
                FmtButton { label: @tr("link"); clicked => { Composer.format(5); } }
                FmtButton { label: @tr("clear"); clicked => { Composer.format(6); } }
            }
        }
    }
}

component ChatPane inherits Rectangle {
    in property <bool> narrow;
    background: Theme.window-bg;
    if !Chat.has-open: Text {
        text: @tr("Select a chat");
        color: Theme.text-muted;
        font-size: 13px;
    }
    if Chat.has-open: VerticalLayout {
        // Шапка чата.
        Rectangle {
            height: 52px;
            background: Theme.card-bg;
            border-width: 0px;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 12px;
                spacing: 10px;
                if root.narrow: Rectangle {
                    width: 36px;
                    accessible-role: button;
                    accessible-label: @tr("Back");
                    TouchArea { clicked => { Chat.back(); } }
                    Path {
                        width: 10px;
                        height: 16px;
                        stroke: Theme.text;
                        stroke-width: 2px;
                        viewbox-width: 10;
                        viewbox-height: 16;
                        commands: "M 9 1 L 2 8 L 9 15";
                    }
                }
                Avatar {
                    y: 6px;
                    size: 40px;
                    initials: Chat.open-initials;
                    tint: Chat.open-color;
                    source: Chat.open-avatar;
                    has-image: Chat.open-has-avatar;
                }
                // Название — сведения о чате (Дз-3, Св-1); лупа — поиск по чату (Дз-10).
                Rectangle {
                    horizontal-stretch: 1;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Chat.show-panel(Chat.panel == 1 ? 0 : 1); }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text { text: Chat.open-name; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
                        if Chat.open-status != "": Text { text: Chat.open-status; color: Theme.text-muted; font-size: 11px; }
                    }
                }
                Rectangle {
                    width: 36px;
                    border-radius: Theme.radius;
                    background: Chat.panel == 2 ? Theme.row-selected : chat-search.has-hover ? Theme.row-bg : transparent;
                    accessible-role: button;
                    accessible-label: @tr("Search in chat");
                    chat-search := TouchArea { clicked => { Chat.show-panel(Chat.panel == 2 ? 0 : 2); } }
                    Path {
                        width: 16px;
                        height: 16px;
                        stroke: Theme.text;
                        stroke-width: 1.6px;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        commands: "M 6.5 1.5 A 5 5 0 1 1 6.49 1.5 Z M 10 10 L 15 15";
                    }
                }
            }
        }
        // Полоса закреплённого (Чт-14): клик — следующее закреплённое.
        if Chat.pinned-text != "": Rectangle {
            height: 40px;
            background: Theme.card-bg;
            border-width: 0px;
            TouchArea { clicked => { Chat.next-pinned(); } }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;
                Rectangle { width: 3px; height: 26px; y: 7px; background: Theme.link; border-radius: 1px; }
                VerticalLayout {
                    alignment: center;
                    Text { text: @tr("Pinned message") + " " + Chat.pinned-counter; color: Theme.link; font-size: 11px; }
                    Text { text: Chat.pinned-text; color: Theme.text; font-size: 12px; overflow: elide; }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.card-border; }
        // История: своя прокрутка (scroller.rs) — строки до опоры прижаты к её
        // линии снизу, от опоры — сверху; ползунок по хронологии (П-2).
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            // Внизу ленты 8 px воздуха над полем ввода.
            init => {
                Chat.view-height(self.height / 1px - 8);
                Chat.view-width(self.width / 1px - 10);
            }
            changed height => { Chat.view-height(self.height / 1px - 8); }
            // Ширина ленты — раскладке текста с эмодзи (О-14).
            changed width => { Chat.view-width(self.width / 1px - 10); }
            TouchArea {
                scroll-event(e) => {
                    Chat.scroll(e.delta-y / 1px);
                    accept
                }
            }
            VerticalLayout {
                x: 0;
                width: parent.width - 10px;
                height: self.preferred-height;
                y: Chat.pivot - self.preferred-height;
                for m in Chat.above: MessageRow { item: m; }
            }
            VerticalLayout {
                x: 0;
                width: parent.width - 10px;
                height: self.preferred-height;
                y: Chat.pivot;
                for m in Chat.below: MessageRow { item: m; }
            }
            if Chat.thumb-visible: Rectangle {
                property <length> th: 36px;
                property <float> drag;
                x: parent.width - 9px;
                y: 4px;
                width: 7px;
                height: parent.height - 8px;
                bar := TouchArea {
                    mouse-cursor: pointer;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            parent.drag = max(0, min(1, (self.mouse-y - parent.th / 2) / (parent.height - parent.th)));
                        }
                        if (e.kind == PointerEventKind.up) {
                            Chat.thumb-release(parent.drag);
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            parent.drag = max(0, min(1, (self.mouse-y - parent.th / 2) / (parent.height - parent.th)));
                        }
                    }
                }
                Rectangle {
                    border-radius: 3px;
                    background: bar.has-hover || bar.pressed ? Theme.soft : transparent;
                }
                Rectangle {
                    y: (bar.pressed ? parent.drag : Chat.thumb) * (parent.height - parent.th);
                    height: parent.th;
                    border-radius: 3px;
                    background: bar.pressed ? Theme.link : bar.has-hover ? Theme.thumb-hover : Theme.thumb;
                }
            }
            // «Вниз» со счётчиком (Чт-10): вне конца истории.
            if !Chat.at-bottom: Rectangle {
                x: parent.width - 58px;
                y: parent.height - 58px;
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: down.has-hover ? Theme.row-bg : Theme.card-bg;
                border-width: 1px;
                border-color: Theme.card-border;
                accessible-role: button;
                accessible-label: @tr("Scroll to bottom");
                down := TouchArea { clicked => { Chat.jump-bottom(); } }
                Path {
                    width: 14px;
                    height: 8px;
                    stroke: Theme.text;
                    stroke-width: 2px;
                    viewbox-width: 14;
                    viewbox-height: 8;
                    commands: "M 1 1 L 7 7 L 13 1";
                }
                if Chat.unread-below > 0: Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: -10px;
                    height: 18px;
                    width: max(18px, badge.preferred-width + 10px);
                    border-radius: 9px;
                    background: Theme.accent;
                    badge := Text { text: Chat.unread-below; color: Theme.text; font-size: 10px; font-weight: 600; }
                }
            }
            if Chat.history-loading && Chat.above.length + Chat.below.length == 0: Text {
                text: @tr("Loading…");
                color: Theme.text-muted;
                font-size: 12px;
            }
        }
        if Chat.error != "": Text {
            text: Chat.error;
            color: Theme.error;
            font-size: 11px;
            horizontal-alignment: center;
        }
        // Подготовка вложений (Св-4): миниатюры, «как фото» или «как файл»;
        // подпись набирается в поле ввода ниже, «Отправить» — его кнопка и Enter.
        if Chat.prepare-open: Rectangle {
            height: prep.preferred-height;
            background: Theme.card-bg;
            Rectangle { y: 0; height: 1px; background: Theme.card-border; }
            prep := VerticalLayout {
                padding: 10px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: Chat.prepare-title;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Link { text: @tr("Cancel"); clicked => { Chat.prepare-cancel(); } }
                }
                Flickable {
                    height: 60px;
                    content-width: thumbs.preferred-width;
                    thumbs := HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        for f[i] in Chat.prepare-files: Rectangle {
                            width: 56px;
                            height: 56px;
                            y: 2px;
                            border-radius: 6px;
                            background: f.has-img ? transparent : Theme.soft;
                            clip: true;
                            if f.has-img: Image { source: f.img; width: 56px; height: 56px; }
                            if !f.has-img: VerticalLayout {
                                padding: 4px;
                                alignment: center;
                                Text { text: f.name; color: Theme.text; font-size: 9px; wrap: word-wrap; horizontal-alignment: center; }
                                Text { text: f.info; color: Theme.text-muted; font-size: 9px; horizontal-alignment: center; }
                            }
                            Rectangle {
                                x: parent.width - 19px;
                                y: 3px;
                                width: 16px;
                                height: 16px;
                                border-radius: 8px;
                                background: rm.has-hover ? #000000e0 : #000000a0;
                                Text { text: "✕"; color: white; font-size: 9px; }
                                rm := TouchArea { mouse-cursor: pointer; clicked => { Chat.prepare-remove(i); } }
                            }
                        }
                        Rectangle {
                            width: 56px;
                            height: 56px;
                            y: 2px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.card-border;
                            background: more.has-hover ? Theme.row-bg : transparent;
                            accessible-role: button;
                            accessible-label: @tr("Add more");
                            Text { text: "+"; color: Theme.link; font-size: 24px; }
                            more := TouchArea { mouse-cursor: pointer; clicked => { Chat.prepare-more(); } }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 18px;
                    alignment: start;
                    Radio {
                        text: @tr("As photo");
                        checked: Chat.prepare-as-photo;
                        enabled: Chat.prepare-can-photo;
                        clicked => { Chat.prepare-photo(true); }
                    }
                    Radio {
                        text: @tr("As file");
                        checked: !Chat.prepare-as-photo;
                        clicked => { Chat.prepare-photo(false); }
                    }
                    Text {
                        text: @tr("Caption — in the field below");
                        color: Theme.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }
        }
        // Ответ или правка: одна панель над полем ввода (Дз, раздел 2).
        if Chat.compose-mode != 0: Rectangle {
            height: 44px;
            background: Theme.card-bg;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 10px;
                Rectangle { width: 3px; height: 30px; y: 7px; background: Theme.link; border-radius: 1px; }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: Chat.compose-mode == 2 ? @tr("Editing") : @tr("Reply to {}", Chat.compose-title);
                        color: Theme.link;
                        font-size: 11px;
                        font-weight: 600;
                    }
                    Text { text: Chat.compose-text; color: Theme.text; font-size: 12px; overflow: elide; }
                }
                Rectangle {
                    width: 28px;
                    accessible-role: button;
                    accessible-label: @tr("Cancel");
                    TouchArea { clicked => { Chat.cancel-compose(); } }
                    Path {
                        width: 12px;
                        height: 12px;
                        stroke: Theme.text-muted;
                        stroke-width: 1.5px;
                        viewbox-width: 12;
                        viewbox-height: 12;
                        commands: "M 1 1 L 11 11 M 11 1 L 1 11";
                    }
                }
            }
        }
        // Поле ввода: гибрид (Дз-17).
        Rectangle {
            height: max(48px, field.height + 24px);
            background: Theme.card-bg;
            HorizontalLayout {
                padding: 8px;
                padding-left: 6px;
                spacing: 8px;
                // Скрепка (Св-4): системный диалог выбора файлов.
                Rectangle {
                    width: 32px;
                    accessible-role: button;
                    accessible-label: @tr("Attach");
                    clip-touch := TouchArea {
                        enabled: Chat.can-write;
                        mouse-cursor: pointer;
                        clicked => { Chat.attach(); }
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        stroke: clip-touch.has-hover ? Theme.link : Theme.text-muted;
                        stroke-width: 1.6px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 14 6 L 7.5 12.5 A 1.8 1.8 0 0 0 10 15 L 16 9 A 3.5 3.5 0 0 0 11 4 L 4.5 10.5 A 5 5 0 0 0 11.5 17.5 L 17 12";
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    field := ComposerField {
                        y: (parent.height - self.height) / 2;
                        width: 100%;
                        enabled: Chat.can-write;
                    }
                }
                Rectangle {
                    width: 36px;
                    accessible-role: button;
                    accessible-label: @tr("Send");
                    send-touch := TouchArea {
                        enabled: (Composer.text != "" || Chat.prepare-open) && !Chat.sending;
                        clicked => { Chat.send(); }
                    }
                    Path {
                        width: 20px;
                        height: 20px;
                        fill: send-touch.enabled ? Theme.link : Theme.text-muted;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 1 18 L 19 10 L 1 2 L 1 8 L 13 10 L 1 12 Z";
                    }
                }
            }
        }
    }
}

// Выпадающий выбор (фильтры поиска по чату): подпись и список вариантов.
component Choice inherits Rectangle {
    in property <string> label;
    in property <[string]> options;
    in property <int> selected;
    callback chosen(int);
    height: 30px;
    width: t.preferred-width + 30px;
    border-radius: 15px;
    border-width: 1px;
    border-color: Theme.card-border;
    background: ct.has-hover ? Theme.row-bg : transparent;
    ct := TouchArea { clicked => { pop.show(); } }
    HorizontalLayout {
        padding-left: 12px;
        spacing: 6px;
        t := Text { text: root.label; color: Theme.text; font-size: 12px; vertical-alignment: center; }
        Path {
            width: 8px;
            height: 5px;
            y: (parent.height - self.height) / 2;
            stroke: Theme.text-muted;
            stroke-width: 1.3px;
            viewbox-width: 8;
            viewbox-height: 5;
            commands: "M 1 1 L 4 4 L 7 1";
        }
    }
    pop := PopupWindow {
        y: root.height + 4px;
        width: 220px;
        Rectangle {
            background: Theme.card-bg;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.card-border;
            VerticalLayout {
                padding: 6px;
                for o[i] in root.options: Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: i == root.selected ? Theme.row-selected : ot.has-hover ? Theme.row-bg : transparent;
                    ot := TouchArea { clicked => { root.chosen(i); } }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: o;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

component PanelAction inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked();
    height: 38px;
    background: pt.has-hover ? Theme.row-bg : transparent;
    pt := TouchArea { clicked => { root.clicked(); } }
    Text {
        x: 16px;
        text: root.text;
        color: root.danger ? Theme.error : Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        height: parent.height;
    }
}

// Правая панель (Дз-3): сведения о чате (Св-1) или поиск по чату (Дз-10, Дз-18).
component RightPanel inherits Rectangle {
    background: Theme.card-bg;
    VerticalLayout {
        Rectangle {
            height: 52px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                Text {
                    text: Chat.panel == 1 ? @tr("Info") : @tr("Search in chat");
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 36px;
                    accessible-role: button;
                    accessible-label: @tr("Close");
                    TouchArea { clicked => { Chat.show-panel(0); } }
                    Path {
                        width: 12px;
                        height: 12px;
                        stroke: Theme.text-muted;
                        stroke-width: 1.5px;
                        viewbox-width: 12;
                        viewbox-height: 12;
                        commands: "M 1 1 L 11 11 M 11 1 L 1 11";
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.card-border; }
        // Сведения.
        if Chat.panel == 1: Rectangle {
            vertical-stretch: 1;
            pf := Flickable {
            VerticalLayout {
                alignment: start;
                padding-top: 18px;
                padding-bottom: 12px;
                spacing: 10px;
                HorizontalLayout {
                    alignment: center;
                    Avatar {
                        size: 80px;
                        initials: Chat.open-initials;
                        tint: Chat.open-color;
                        source: Chat.open-avatar;
                        has-image: Chat.open-has-avatar;
                    }
                }
                Text { text: Chat.open-name; color: Theme.text; font-size: 16px; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
                if Chat.info-status != "": Text { text: Chat.info-status; color: Theme.text-muted; font-size: 12px; horizontal-alignment: center; }
                if Chat.info-about != "" || Chat.info-username != "": VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 4px;
                    if Chat.info-about != "": Text { text: Chat.info-about; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                    if Chat.info-username != "": Text { text: Chat.info-username; color: Theme.link; font-size: 13px; }
                }
                if !Chat.info-self: Rectangle {
                    height: 40px;
                    TouchArea { clicked => { Chat.dialog-action(Chat.open-id, Chat.info-muted ? 1 : 0); } }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text { text: @tr("Notifications"); color: Theme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                        Text {
                            text: Chat.info-muted ? @tr("off") : @tr("on");
                            color: Chat.info-muted ? Theme.text-muted : Theme.link;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.card-border; }
                // Вкладки: у групп первая — участники; у канала и личного её нет (Св-6).
                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 2px;
                    if Chat.info-kind == 1: FmtButton { label: @tr("Members"); on: Chat.shared-tab == 0; clicked => { Chat.shared-select(0); } }
                    FmtButton { label: @tr("Media"); on: Chat.shared-tab == 1; clicked => { Chat.shared-select(1); } }
                    FmtButton { label: @tr("Files"); on: Chat.shared-tab == 2; clicked => { Chat.shared-select(2); } }
                    FmtButton { label: @tr("Links"); on: Chat.shared-tab == 3; clicked => { Chat.shared-select(3); } }
                    FmtButton { label: @tr("Voice"); on: Chat.shared-tab == 4; clicked => { Chat.shared-select(4); } }
                }
                if Chat.shared-tab == 0 && Chat.info-kind == 1: VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 4px;
                    Field {
                        field-width: 356px;
                        placeholder: @tr("Search members");
                        edited(t) => { Chat.members-edited(t); }
                    }
                    for m in Chat.info-members: HorizontalLayout {
                        height: 44px;
                        spacing: 10px;
                        Avatar { y: 4px; size: 36px; initials: m.initials; tint: m.color; source: m.avatar; has-image: m.has-avatar; }
                        Text { text: m.name; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        if m.role != "": Text { text: m.role; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
                    }
                }
                // Медиа: сетка 3 × 116 px.
                if Chat.shared-tab == 1: Rectangle {
                    height: Math.ceil(Chat.shared-cells.length / 3) * 120px;
                    for c[i] in Chat.shared-cells: Rectangle {
                        x: 12px + Math.mod(i, 3) * 120px;
                        y: Math.floor(i / 3) * 120px;
                        width: 116px;
                        height: 116px;
                        background: Theme.strip-bg;
                        clip: true;
                        if c.has-img: Image { width: parent.width; height: parent.height; source: c.img; image-fit: cover; }
                        if c.play: Rectangle {
                            x: 4px;
                            y: parent.height - 20px;
                            width: dt.preferred-width + 10px;
                            height: 16px;
                            border-radius: 8px;
                            background: #00000099;
                            dt := Text { text: c.dur == "" ? "▶" : "▶ " + c.dur; color: white; font-size: 10px; }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { Chat.shared-open(c.id); } }
                    }
                }
                // Файлы, ссылки, голосовые: список.
                if Chat.shared-tab >= 2: VerticalLayout {
                    for r in Chat.shared-rows: Rectangle {
                        height: 48px;
                        ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { if r.icon == 1 { Chat.open-link(r.url); } else { Chat.shared-open(r.id); } }
                        }
                        background: ta.has-hover ? Theme.soft : transparent;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 10px;
                            Rectangle {
                                y: 6px;
                                width: 36px;
                                height: 36px;
                                border-radius: 18px;
                                background: Theme.accent;
                                Text {
                                    text: r.icon == 1 ? "↗" : r.state == 1 ? "✕" : r.state == 0 ? "↓" : r.icon == 2 ? "▶" : "≡";
                                    color: Theme.on-accent;
                                    font-size: 15px;
                                }
                                if r.state == 1: Rectangle {
                                    x: 4px;
                                    y: parent.height - 6px;
                                    width: (parent.width - 8px) * r.progress;
                                    height: 2px;
                                    background: Theme.on-accent;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text { text: r.title; color: r.icon == 1 ? Theme.link : Theme.text; font-size: 13px; overflow: elide; }
                                Text { text: r.subtitle; color: Theme.text-muted; font-size: 11px; overflow: elide; }
                            }
                        }
                    }
                }
                if Chat.shared-tab >= 1 && Chat.shared-loading: Text {
                    text: @tr("Loading…");
                    color: Theme.text-muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
                if Chat.shared-tab >= 1 && !Chat.shared-loading && Chat.shared-cells.length == 0 && Chat.shared-rows.length == 0: Text {
                    text: @tr("Nothing here yet");
                    color: Theme.text-muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
                if Chat.shared-tab >= 1 && !Chat.shared-loading && !Chat.shared-complete: HorizontalLayout {
                    alignment: center;
                    Link { text: @tr("Show more"); font-size: 12px; clicked => { Chat.shared-more(); } }
                }
                Rectangle { height: 1px; background: Theme.card-border; }
                if !Chat.info-self: PanelAction {
                    text: Chat.info-archived ? @tr("Unarchive") : @tr("Archive");
                    clicked => { Chat.dialog-action(Chat.open-id, Chat.info-archived ? 3 : 2); }
                }
                PanelAction { text: @tr("Clear history"); danger: true; clicked => { Chat.dialog-action(Chat.open-id, 7); } }
                if Chat.info-kind == 0 && !Chat.info-self: PanelAction {
                    text: Chat.info-blocked ? @tr("Unblock") : @tr("Block");
                    danger: !Chat.info-blocked;
                    clicked => { Chat.dialog-action(Chat.open-id, Chat.info-blocked ? 11 : 10); }
                }
                if Chat.info-kind != 0: PanelAction {
                    text: Chat.info-kind == 2 ? @tr("Leave channel") : @tr("Leave group");
                    danger: true;
                    clicked => { Chat.dialog-action(Chat.open-id, 9); }
                }
            }
            }
            ThinScrollbar {
                x: parent.width - self.width;
                height: parent.height;
                content: pf.content-height;
                view: pf.height;
                pos <=> pf.content-y;
            }
        }
        // Поиск по чату (Дз-18): поле, стрелки и счётчик, фильтры, результаты.
        if Chat.panel == 2: VerticalLayout {
            vertical-stretch: 1;
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 6px;
                Field {
                    horizontal-stretch: 1;
                    field-width: 250px;
                    placeholder: @tr("Search");
                    text <=> Chat.cs-query;
                    init => { self.focus-input(); }
                    edited(t) => { Chat.cs-edited(t); }
                    accepted => { Chat.cs-step(1); }
                    escape => { Chat.show-panel(0); }
                }
                FmtButton { label: "▲"; clicked => { Chat.cs-step(1); } }
                FmtButton { label: "▼"; clicked => { Chat.cs-step(-1); } }
            }
            if Chat.cs-counter != "": Text { text: Chat.cs-counter; color: Theme.text-muted; font-size: 11px; }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Choice {
                    label: [@tr("Any type"), @tr("Media"), @tr("Files"), @tr("Links"), @tr("Voice")][Chat.cs-filter];
                    options: [@tr("Any type"), @tr("Media"), @tr("Files"), @tr("Links"), @tr("Voice")];
                    selected: Chat.cs-filter;
                    chosen(i) => { Chat.cs-set-filter(i); }
                }
                Choice {
                    label: [@tr("Any date"), @tr("Day"), @tr("Week"), @tr("Month"), @tr("Year")][Chat.cs-period];
                    options: [@tr("Any date"), @tr("Day"), @tr("Week"), @tr("Month"), @tr("Year")];
                    selected: Chat.cs-period;
                    chosen(i) => { Chat.cs-set-period(i); }
                }
                // Отправитель — в группах (Дз-18): 0 — любой, дальше участники.
                if Chat.info-kind == 1: Choice {
                    label: Chat.cs-from-name == "" ? @tr("Any sender") : Chat.cs-from-name;
                    options: Chat.cs-from-options;
                    selected: 0;
                    chosen(i) => { Chat.cs-set-from(i == 0 ? "" : Chat.info-members[i - 1].id); }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                if Chat.cs-rows.length == 0 && (Chat.cs-query != "" || Chat.cs-filter != 0): Text {
                    y: 12px;
                    text: Chat.cs-loading ? @tr("Searching…") : @tr("Nothing found");
                    color: Theme.text-muted;
                    font-size: 12px;
                }
                csl := ListView {
                    vertical-scrollbar-policy: always-off;
                    for r in Chat.cs-rows: SearchResult { item: r; clicked => { Chat.cs-open(r.msg); } }
                    changed viewport-y => {
                        if (self.content-y < self.visible-height - self.content-height + 200px) {
                            Chat.cs-more();
                        }
                    }
                }
                ThinScrollbar {
                    x: parent.width - self.width;
                    height: parent.height;
                    content: csl.content-height;
                    view: csl.visible-height;
                    pos <=> csl.content-y;
                }
            }
        }
    }
}

export component MainScreen inherits Rectangle {
    property <bool> narrow: root.width < 780px;
    background: Theme.window-bg;
    HorizontalLayout {
        if !root.narrow || !Chat.has-open: DialogList {
            width: root.narrow ? root.width : 360px;
        }
        if !root.narrow: Rectangle { width: 1px; background: Theme.card-border; }
        if !root.narrow || Chat.has-open: ChatPane {
            narrow: root.narrow;
            horizontal-stretch: 1;
        }
        // Правая панель колонкой, если чату остаётся место; иначе — поверх чата.
        if Chat.has-open && Chat.panel != 0 && !root.panel-over: Rectangle { width: 1px; background: Theme.card-border; }
        if Chat.has-open && Chat.panel != 0 && !root.panel-over: RightPanel { width: 380px; }
    }
    property <bool> panel-over: root.width < 1140px;
    if Chat.has-open && Chat.panel != 0 && root.panel-over: RightPanel {
        x: root.width - self.width;
        width: min(380px, root.width);
        height: root.height;
    }
    // Подтверждение опасного действия над чатом (Сп-4): очистить, удалить, выйти, заблокировать.
    if Chat.action-confirm: Modal {
        width: 100%;
        height: 100%;
        Rectangle {
            width: 380px;
            height: act.preferred-height;
            background: Theme.card-bg;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.card-border;
            act := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text { text: Chat.action-title; color: Theme.text; font-size: 15px; font-weight: 600; }
                Text { text: Chat.action-text; color: Theme.text-muted; font-size: 13px; wrap: word-wrap; }
                if Chat.action-can-revoke: HorizontalLayout {
                    spacing: 10px;
                    CheckBox { checked: Chat.action-revoke; toggled => { Chat.action-toggle-revoke(); } }
                    Text { text: Chat.action-revoke-text; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 12px;
                    Button { button-width: 120px; primary: false; text: @tr("Cancel"); clicked => { Chat.action-cancel(); } }
                    Button { button-width: 150px; text: Chat.action-ok; clicked => { Chat.action-confirmed(); } }
                }
            }
        }
    }
    // Диалог выбора (Дз-16): поиск, недавние и контакты; для пересылки — несколько адресатов.
    if Chat.picker-open: Modal {
        width: 100%;
        height: 100%;
        Rectangle {
            width: min(420px, root.width - 32px);
            height: min(560px, root.height - 32px);
            background: Theme.card-bg;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.card-border;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: Chat.picker-forward ? @tr("Forward to…") : @tr("New chat");
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 600;
                }
                Field {
                    field-width: parent.width - 32px;
                    placeholder: @tr("Search");
                    text <=> Chat.picker-query;
                    edited(t) => { Chat.picker-query-edited(t); }
                    escape => { Chat.picker-close(); }
                    init => { self.focus-input(); }
                }
                Rectangle {
                    vertical-stretch: 1;
                    pl := ListView {
                        vertical-scrollbar-policy: always-off;
                        for p in Chat.picker-items: Rectangle {
                            height: 52px;
                            border-radius: 6px;
                            background: p.selected ? Theme.row-selected : pt.has-hover ? Theme.row-bg : transparent;
                            pt := TouchArea { clicked => { Chat.picker-toggle(p.id); } }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 10px;
                                spacing: 10px;
                                Avatar { y: 6px; size: 40px; initials: p.initials; tint: p.color; }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: p.name; color: Theme.text; font-size: 13px; overflow: elide; }
                                    if p.subtitle != "": Text { text: p.subtitle; color: Theme.text-muted; font-size: 11px; overflow: elide; }
                                }
                                if Chat.picker-forward: CheckBox { y: 15px; checked: p.selected; toggled => { Chat.picker-toggle(p.id); } }
                            }
                        }
                    }
                    ThinScrollbar {
                        x: parent.width - self.width;
                        height: parent.height;
                        content: pl.content-height;
                        view: pl.visible-height;
                        pos <=> pl.content-y;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    Button { button-width: 120px; primary: false; text: @tr("Cancel"); clicked => { Chat.picker-close(); } }
                    Button {
                        button-width: 160px;
                        text: Chat.picker-forward ? @tr("Forward ({})", Chat.picker-selected) : @tr("Write");
                        enabled: Chat.picker-selected > 0;
                        clicked => { Chat.picker-confirm(); }
                    }
                }
            }
        }
    }
    if Chat.delete-open: Modal {
        width: 100%;
        height: 100%;
        Rectangle {
            width: 380px;
            height: del-layout.preferred-height;
            background: Theme.card-bg;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.card-border;
            del-layout := VerticalLayout {
                padding: 24px;
                spacing: 16px;
                Text {
                    text: Chat.delete-count > 1 ? @tr("Delete {} messages?", Chat.delete-count) : @tr("Delete message?");
                    color: Theme.text;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
                if Chat.delete-can-revoke: HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    CheckBox { checked: Chat.delete-revoke; toggled => { Chat.toggle-revoke(); } }
                    Text { text: @tr("Also delete for the other side"); color: Theme.text; font-size: 12px; vertical-alignment: center; }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 12px;
                    Button { button-width: 150px; primary: false; text: @tr("Cancel"); clicked => { Chat.cancel-delete(); } }
                    Button { button-width: 150px; text: @tr("Delete"); clicked => { Chat.confirm-delete(); } }
                }
            }
        }
    }
    // Всплывающее сообщение внизу по центру (Со-3), не перехватывает ввод.
    if Chat.toast != "": Rectangle {
        y: root.height - 150px;
        x: (root.width - self.width) / 2;
        width: toast-text.preferred-width + 32px;
        height: 36px;
        background: Theme.strip-bg;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.card-border;
        toast-text := Text { text: Chat.toast; color: Theme.text; font-size: 12px; }
    }
    // Диалог ссылки поля ввода (Дз-15): адрес для выделенного текста.
    if Composer.link-open: Modal {
        width: 100%;
        height: 100%;
        Rectangle {
            width: 380px;
            height: link-layout.preferred-height;
            background: Theme.card-bg;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.card-border;
            link-layout := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text { text: @tr("Link"); color: Theme.text; font-size: 14px; font-weight: 600; }
                url-field := Field {
                    field-width: 332px;
                    text <=> Composer.link-url;
                    placeholder: "https://";
                    init => { self.focus-input(); }
                    accepted => { Composer.link-apply(Composer.link-url); }
                    escape => { Composer.link-open = false; }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 12px;
                    Button { button-width: 120px; primary: false; text: @tr("Cancel"); clicked => { Composer.link-open = false; } }
                    Button { button-width: 120px; text: @tr("Apply"); clicked => { Composer.link-apply(Composer.link-url); } }
                }
            }
        }
    }
    if Chat.confirm-link != "": Modal {
        width: 100%;
        height: 100%;
        Confirm {
            text: @tr("Open this link?\n{}", Chat.confirm-link);
            ok-text: @tr("Open");
            ok => { Chat.open-link-now(Chat.confirm-link); Chat.confirm-link = ""; }
            cancel => { Chat.confirm-link = ""; }
        }
    }
    // Реклама: «О рекламодателе» и выбор причины жалобы.
    if Chat.sp-info-open: Modal {
        width: 100%;
        height: 100%;
        Rectangle {
            width: 380px;
            height: il.preferred-height;
            background: Theme.card-bg;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.card-border;
            il := VerticalLayout {
                padding: 22px;
                spacing: 10px;
                Text { text: @tr("About the advertiser"); color: Theme.text; font-size: 14px; font-weight: 600; }
                if Chat.sp-sponsor != "": Text { text: Chat.sp-sponsor; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                if Chat.sp-additional != "": Text { text: Chat.sp-additional; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; }
                Text {
                    text: @tr("Ads are shown by Telegram; this app is required to show them by the Telegram API terms.");
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    Button { button-width: 120px; primary: false; text: @tr("Close"); clicked => { Chat.sp-info(false); } }
                }
            }
        }
    }
    if Chat.sp-report-title != "": Modal {
        width: 100%;
        height: 100%;
        Rectangle {
            width: 380px;
            height: rl.preferred-height;
            background: Theme.card-bg;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.card-border;
            rl := VerticalLayout {
                padding: 22px;
                spacing: 6px;
                Text { text: Chat.sp-report-title; color: Theme.text; font-size: 14px; font-weight: 600; }
                for o[i] in Chat.sp-report-options: Rectangle {
                    height: 36px;
                    border-radius: Theme.radius;
                    background: ot.has-hover ? Theme.soft : transparent;
                    ot := TouchArea { mouse-cursor: pointer; clicked => { Chat.sp-report-pick(i); } }
                    Text { x: 10px; text: o; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                }
                HorizontalLayout {
                    alignment: end;
                    Button { button-width: 120px; primary: false; text: @tr("Cancel"); clicked => { Chat.sp-report-cancel(); } }
                }
            }
        }
    }
    // Нс-6: выход с подтверждением — удаляются сессия, ключ, база и кэш.
    if Chat.confirm-logout: Modal {
        width: 100%;
        height: 100%;
        Confirm {
            text: @tr("Log out? The session will be ended and all local data (messages, cache, keys) deleted.");
            ok-text: @tr("Log out");
            ok => { Chat.confirm-logout = false; Chat.log-out(); }
            cancel => { Chat.confirm-logout = false; }
        }
    }
    // Настройки (В9): модальное окно поверх главного.
    if Settings.open: SettingsWindow {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
    }
}
