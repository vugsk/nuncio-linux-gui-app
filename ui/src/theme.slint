// Тема (Архитектура/nuncio - Приложение (Rust и Slint).md, раздел 5): компоненты
// берут цвета и размеры только отсюда. Значения — из макетов (Дизайн/nuncio -
// Макет - Вход и др.): тёмная тема по умолчанию (Дз-1). Светлая, «как в
// системе» и своя из theme.toml — веха В9 (Rust будет записывать сюда значения).
export global Theme {
    // Цвета
    in-out property <color> window-bg: #0e1621;
    in-out property <color> card-bg: #17212b;
    in-out property <color> card-border: #3d4f61;
    in-out property <color> field-bg: #0e1621;
    in-out property <color> field-border: #3d4f61;
    in-out property <color> field-focus: #6ab3f3;
    in-out property <color> row-bg: #182533;
    in-out property <color> row-selected: #2b5278;
    in-out property <color> accent: #2b5278;
    in-out property <color> accent-border: #6ab3f3;
    in-out property <color> accent-hover: #34628f;
    in-out property <color> text: #e6edf3;
    in-out property <color> text-muted: #8a9aa8;
    in-out property <color> link: #6ab3f3;
    in-out property <color> error: #ff6b6b;
    in-out property <color> success: #2f9e44;
    in-out property <color> strip-bg: #182533;
    in-out property <color> qr-bg: #ffffff;
    // В9: токены, чтобы темы (светлая, из файла) не упирались в числа в разметке.
    in-out property <color> on-accent: #e6edf3;      // текст на кнопке акцента
    in-out property <color> bubble-in: #182533;
    in-out property <color> bubble-in-border: #3d4f61;
    in-out property <color> bubble-out: #2b5278;
    in-out property <color> bubble-out-border: #6ab3f3;
    in-out property <color> bubble-error: #3a2530;
    in-out property <color> reply-text: #c9d6e2;
    in-out property <color> soft: #ffffff10;         // подложка при наведении, заглушки
    in-out property <color> soft-strong: #ffffff20;
    in-out property <color> mono-bg: #ffffff12;
    in-out property <color> thumb: #8a9bb080;        // ползунки прокрутки
    in-out property <color> thumb-hover: #8a9bb0c0;
    in-out property <color> poll-chosen: #2f5a86;
    in-out property <color> poll-correct: #3a6b4a;
    in-out property <color> on-link: #1e1e1e;        // знак на кнопке цвета ссылки
    // Текст сообщений (размер — настройка «Размер текста»).
    in-out property <length> msg-size: 13px;
    in-out property <length> msg-line: 20px;
    in-out property <length> msg-emoji: 18px;

    // Размеры (px)
    in-out property <length> card-width: 352px;
    in-out property <length> card-min-height: 512px;
    in-out property <length> field-width: 300px;
    in-out property <length> field-height: 44px;
    in-out property <length> button-height: 44px;
    in-out property <length> radius: 8px;
    in-out property <length> title-size: 18px;
    in-out property <length> body-size: 14px;
    in-out property <length> small-size: 12px;
    in-out property <length> tiny-size: 11px;
}
