// Окно просмотра фото (Св-3): отдельное окно, создаётся по запросу и
// уничтожается при закрытии. Шапка — автор, дата, номер; действия —
// сохранить, переслать, показать в чате. Колесо — масштаб, перетаскивание —
// сдвиг, «по размеру» — сброс; стрелки — соседние фото окна истории,
// Esc — закрыть, F11 и двойной клик — во весь экран, Ctrl+S — сохранить.
import { Theme } from "theme.slint";

component Action inherits Rectangle {
    in property <string> text;
    callback clicked();
    width: t.preferred-width + 20px;
    height: 30px;
    border-radius: 15px;
    background: ta.has-hover ? #ffffff30 : #00000080;
    t := Text { text: root.text; color: white; font-size: 12px; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component ViewerWindow inherits Window {
    title: @tr("Photo");
    preferred-width: 1000px;
    preferred-height: 720px;
    min-width: 480px;
    min-height: 320px;
    background: #101214;
    in property <image> photo;
    in property <bool> has-photo;
    in property <string> author;
    in property <string> date;
    in property <string> counter;   // «3 из 12»
    in property <string> caption;
    in property <string> progress;  // ход скачивания полного размера
    in property <bool> can-prev;
    in property <bool> can-next;
    callback step(int);
    callback close-viewer();
    callback toggle-fullscreen();
    callback save();
    callback forward();
    callback show-in-chat();
    // Масштаб относительно «по размеру окна» (1) и сдвиг изображения.
    property <float> zoom: 1;
    property <length> pan-x;
    property <length> pan-y;
    property <float> fit: root.has-photo && photo.width > 0
        ? min(1, min(root.width / 1px / photo.width, root.height / 1px / photo.height)) : 1;
    property <length> img-w: photo.width * 1px * fit * zoom;
    property <length> img-h: photo.height * 1px * fit * zoom;
    changed photo => { root.zoom = 1; root.pan-x = 0; root.pan-y = 0; }
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.LeftArrow) { root.step(-1); return accept; }
            if (e.text == Key.RightArrow) { root.step(1); return accept; }
            if (e.text == Key.Escape) { root.close-viewer(); return accept; }
            if (e.text == Key.F11) { root.toggle-fullscreen(); return accept; }
            if (e.modifiers.control && (e.text == "s" || e.text == "ы")) { root.save(); return accept; }
            reject
        }
    }
    drag := TouchArea {
        property <length> start-x;
        property <length> start-y;
        mouse-cursor: root.zoom > 1 ? (self.pressed ? grabbing : grab) : default;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.start-x = root.pan-x - self.mouse-x;
                self.start-y = root.pan-y - self.mouse-y;
            }
        }
        moved => {
            if (root.zoom > 1) {
                root.pan-x = max(-(root.img-w - root.width) / 2, min((root.img-w - root.width) / 2, self.start-x + self.mouse-x));
                root.pan-y = max(-(root.img-h - root.height) / 2, min((root.img-h - root.height) / 2, self.start-y + self.mouse-y));
            }
        }
        double-clicked => { root.toggle-fullscreen(); }
        scroll-event(e) => {
            if (e.delta-y > 0) { root.zoom = min(8, root.zoom * 1.25); }
            if (e.delta-y < 0) { root.zoom = max(1, root.zoom / 1.25); }
            if (root.zoom == 1) { root.pan-x = 0; root.pan-y = 0; }
            accept
        }
    }
    if root.has-photo: Image {
        source: root.photo;
        width: root.img-w;
        height: root.img-h;
        x: (root.width - self.width) / 2 + root.pan-x;
        y: (root.height - self.height) / 2 + root.pan-y;
        image-rendering: smooth;
    }
    if !root.has-photo || root.progress != "": Rectangle {
        y: parent.height / 2 - 16px;
        height: 32px;
        width: load-text.preferred-width + 24px;
        border-radius: 16px;
        background: #000000a0;
        load-text := Text { text: root.progress != "" ? root.progress : @tr("Loading…"); color: white; font-size: 12px; }
    }
    // Шапка: автор и дата слева, номер, действия и «закрыть» справа.
    Rectangle {
        y: 0;
        height: 52px;
        background: #000000a0;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 10px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.author; color: white; font-size: 13px; font-weight: 600; overflow: elide; }
                Text { text: root.date; color: #c8d0d8; font-size: 11px; }
            }
            if root.counter != "": Text { text: root.counter; color: #c8d0d8; font-size: 12px; vertical-alignment: center; }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 6px;
                    if root.zoom > 1: Action { text: @tr("Fit"); clicked => { root.zoom = 1; root.pan-x = 0; root.pan-y = 0; } }
                    Action { text: @tr("Save"); clicked => { root.save(); } }
                    Action { text: @tr("Forward"); clicked => { root.forward(); } }
                    Action { text: @tr("Show in chat"); clicked => { root.show-in-chat(); } }
                    Action { text: "✕"; clicked => { root.close-viewer(); } }
                }
            }
        }
    }
    if root.caption != "": Rectangle {
        y: parent.height - self.height - 16px;
        x: (parent.width - self.width) / 2;
        width: min(parent.width - 32px, cap-text.preferred-width + 24px);
        height: cap-text.preferred-height + 12px;
        border-radius: 8px;
        background: #000000a0;
        cap-text := Text {
            width: parent.width - 24px;
            text: root.caption;
            color: white;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
    if root.can-prev: Rectangle {
        x: 12px;
        y: parent.height / 2 - 24px;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background: prev-ta.has-hover ? #ffffff30 : #00000080;
        Text { text: "‹"; color: white; font-size: 28px; }
        prev-ta := TouchArea { mouse-cursor: pointer; clicked => { root.step(-1); } }
    }
    if root.can-next: Rectangle {
        x: parent.width - 60px;
        y: parent.height / 2 - 24px;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background: next-ta.has-hover ? #ffffff30 : #00000080;
        Text { text: "›"; color: white; font-size: 28px; }
        next-ta := TouchArea { mouse-cursor: pointer; clicked => { root.step(1); } }
    }
}
