// Окно просмотра фото (Св-3): отдельное окно, создаётся по запросу и
// уничтожается при закрытии. Стрелки — соседние фото окна истории,
// Esc — закрыть, F11 и двойной клик — во весь экран.
import { Theme } from "theme.slint";

export component ViewerWindow inherits Window {
    title: @tr("Photo");
    preferred-width: 1000px;
    preferred-height: 720px;
    min-width: 320px;
    min-height: 240px;
    background: #101214;
    in property <image> photo;
    in property <bool> has-photo;
    in property <string> counter;   // «3 из 12»
    in property <string> caption;
    in property <string> progress;  // ход скачивания полного размера
    in property <bool> can-prev;
    in property <bool> can-next;
    callback step(int);
    callback close-viewer();
    callback toggle-fullscreen();
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.LeftArrow) { root.step(-1); return accept; }
            if (e.text == Key.RightArrow) { root.step(1); return accept; }
            if (e.text == Key.Escape) { root.close-viewer(); return accept; }
            if (e.text == Key.F11) { root.toggle-fullscreen(); return accept; }
            reject
        }
    }
    TouchArea {
        double-clicked => { root.toggle-fullscreen(); }
    }
    if root.has-photo: Image {
        source: root.photo;
        width: parent.width;
        height: parent.height;
        image-fit: contain;
    }
    if !root.has-photo || root.progress != "": Rectangle {
        y: parent.height / 2 - 16px;
        height: 32px;
        width: load-text.preferred-width + 24px;
        border-radius: 16px;
        background: #000000a0;
        load-text := Text { text: root.progress != "" ? root.progress : @tr("Loading…"); color: white; font-size: 12px; }
    }
    if root.counter != "": Rectangle {
        x: 12px;
        y: 12px;
        width: counter-text.preferred-width + 20px;
        height: 26px;
        border-radius: 13px;
        background: #000000a0;
        counter-text := Text { text: root.counter; color: white; font-size: 12px; }
    }
    if root.caption != "": Rectangle {
        y: parent.height - self.height - 16px;
        x: (parent.width - self.width) / 2;
        width: min(parent.width - 32px, cap-text.preferred-width + 24px);
        height: cap-text.preferred-height + 12px;
        border-radius: 8px;
        background: #000000a0;
        cap-text := Text {
            width: parent.width - 24px;
            text: root.caption;
            color: white;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
    if root.can-prev: Rectangle {
        x: 12px;
        y: parent.height / 2 - 24px;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background: prev-ta.has-hover ? #ffffff30 : #00000080;
        Text { text: "‹"; color: white; font-size: 28px; }
        prev-ta := TouchArea { mouse-cursor: pointer; clicked => { root.step(-1); } }
    }
    if root.can-next: Rectangle {
        x: parent.width - 60px;
        y: parent.height / 2 - 24px;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background: next-ta.has-hover ? #ffffff30 : #00000080;
        Text { text: "›"; color: white; font-size: 28px; }
        next-ta := TouchArea { mouse-cursor: pointer; clicked => { root.step(1); } }
    }
    Rectangle {
        x: parent.width - 44px;
        y: 8px;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: close-ta.has-hover ? #ffffff30 : #00000080;
        Text { text: "✕"; color: white; font-size: 16px; }
        close-ta := TouchArea { mouse-cursor: pointer; clicked => { root.close-viewer(); } }
    }
}
