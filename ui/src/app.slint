// Корневое окно: старт, критические состояния (Со-4), вход, главное окно.
// Рендерер — software (О-13); рамка окна системная (Дз-5).
import { Theme } from "theme.slint";
import { Button, Link, Modal, Confirm } from "widgets.slint";
import { Chat, Composer, DialogItem, FolderItem, MemberItem, MessageItem, PickerItem, RichLine, RichSeg, SearchRow, SelRect,
    MainScreen } from "main.slint";
import { Login, Proxy, CountryRow, LoginScreen } from "login.slint";

export { Theme, Login, Proxy, CountryRow, Chat, Composer, DialogItem, FolderItem, MemberItem, MessageItem, PickerItem,
    RichLine, RichSeg, SearchRow, SelRect }

export global Shell {
    // 0 старт, 1 критическое состояние, 2 вход, 3 главное окно
    in property <int> screen;
    // Критическое: 0 нет Secret Service, 1 связка заблокирована, 2 нет api.env,
    // 3 повреждена база, 4 сбой сетевого слоя.
    in property <int> critical-kind;
    in property <string> critical-detail;
    // Соединение: 0 подключено или ещё не известно, 1 подключение, 2 нет сети.
    in property <int> conn;
    in property <string> user-name;
    in property <bool> busy;
    callback retry();
    callback quit();
    callback log-out();
    callback reset-data();
}

component Strip inherits Rectangle {
    height: 28px;
    background: Theme.strip-bg;
    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        Text {
            text: Shell.conn == 2 ? @tr("No network. Connecting…") : @tr("Connecting…");
            color: Theme.text-muted;
            font-size: Theme.small-size;
            vertical-alignment: center;
        }
        if Shell.screen == 2: Link {
            text: @tr("Connection settings");
            vertical-alignment: center;
            clicked => { Login.open-proxy(); }
        }
    }
}

component StartingScreen inherits Rectangle {
    background: Theme.window-bg;
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        Text { text: "nuncio"; color: Theme.text; font-size: 20px; horizontal-alignment: center; }
        Text { text: @tr("Loading…"); color: Theme.text-muted; font-size: Theme.small-size; horizontal-alignment: center; }
        Text {
            text: @tr("If the system asks, unlock the keyring");
            color: Theme.text-muted;
            font-size: Theme.tiny-size;
            horizontal-alignment: center;
        }
    }
}

// Со-4: отдельный экран в окне — причина, что делать, «Повторить» и «Выйти»;
// для повреждённой базы ещё «Сбросить локальные данные» (Со-5).
component CriticalScreen inherits Rectangle {
    in-out property <bool> confirm-reset;
    background: Theme.window-bg;
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 440px;
                height: layout.preferred-height;
                background: Theme.card-bg;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.card-border;
                layout := VerticalLayout {
                    padding: 28px;
                    spacing: 14px;
                    Text {
                        text: Shell.critical-kind == 0 ? @tr("Keyring (Secret Service) not found")
                            : Shell.critical-kind == 1 ? @tr("The keyring is locked")
                            : Shell.critical-kind == 2 ? @tr("api_id and api_hash are not set")
                            : Shell.critical-kind == 3 ? @tr("The local database is damaged")
                            : @tr("The network layer failed to start");
                        color: Theme.text;
                        font-size: Theme.title-size;
                        font-weight: 600;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: Shell.critical-kind == 0 ? @tr("nuncio keeps the session key only in the system keyring. Start GNOME Keyring, KWallet or KeePassXC with Secret Service integration and press Retry.")
                            : Shell.critical-kind == 1 ? @tr("Unlock the keyring when the system asks for its password, then press Retry. If no password window appears, install a keyring prompter (the gcr package).")
                            : Shell.critical-kind == 2 ? @tr("Create ~/.config/nuncio/api.env with the lines API_ID=… and API_HASH=… (get them at my.telegram.org) and restart the app.")
                            : Shell.critical-kind == 3 ? @tr("The app cannot read its local data. You can retry, quit, or reset the local data (messages will be downloaded again).")
                            : @tr("Try again. If it keeps failing, see the log in ~/.local/state/nuncio.");
                        color: Theme.text-muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if Shell.critical-detail != "": Text {
                        text: Shell.critical-detail;
                        color: Theme.text-muted;
                        font-size: Theme.tiny-size;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 12px;
                        if Shell.critical-kind != 2: Button {
                            button-width: 150px;
                            text: @tr("Retry");
                            enabled: !Shell.busy;
                            clicked => { Shell.retry(); }
                        }
                        Button { button-width: 150px; primary: false; text: @tr("Quit"); clicked => { Shell.quit(); } }
                    }
                    if Shell.critical-kind == 3: HorizontalLayout {
                        alignment: center;
                        Link { text: @tr("Reset local data"); color: Theme.error; clicked => { root.confirm-reset = true; } }
                    }
                }
            }
        }
    }
    if root.confirm-reset: Modal {
        width: 100%;
        height: 100%;
        Confirm {
            text: @tr("Delete all local data? You will stay logged in; chats will be downloaded again.");
            ok-text: @tr("Reset");
            ok => { root.confirm-reset = false; Shell.reset-data(); }
            cancel => { root.confirm-reset = false; }
        }
    }
}

export component App inherits Window {
    title: "nuncio";
    preferred-width: 1100px;
    preferred-height: 800px;
    min-width: 400px;
    min-height: 600px;
    background: Theme.window-bg;
    default-font-size: Theme.body-size;
    VerticalLayout {
        if (Shell.screen == 2 || Shell.screen == 3) && Shell.conn != 0: Strip { }
        Rectangle {
            vertical-stretch: 1;
            if Shell.screen == 0: StartingScreen { width: 100%; height: 100%; }
            if Shell.screen == 1: CriticalScreen { width: 100%; height: 100%; }
            if Shell.screen == 2: LoginScreen { width: 100%; height: 100%; }
            if Shell.screen == 3: MainScreen { width: 100%; height: 100%; }
        }
    }
}
