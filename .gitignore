/target/
# Cargo.lock коммитится: это приложение (app/), не библиотека для
# подключения в другой код.

# Генерируется just tl / just proto — не коммитится (см. Архитектура/Сборка и структура репозитория)
/net/tl/
/net/gen/

# Кэш скачанных и собранных внешних зависимостей (just deps)
/.deps-cache/

# Артефакты C++ и Go
/core/build/
/core/build-*/
/core/.cache/
compile_commands.json
*.o
*.a
*.so
/tools/tlgen/tlgen

# Собранные пакеты (выходы makepkg — ещё и в packaging/arch/.gitignore)
*.pkg.tar.*

# Ключи API и прочие локальные секреты — никогда в репозиторий
*.env
/code.txt
/password.txt

# IDE и редакторы
.idea/
*.iml
.vscode/
.zed/
*.swp
*~
.claude/

# Мусор окружения
.DS_Store
.directory
